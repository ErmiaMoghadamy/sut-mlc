---
import constants from '../constants.json';

const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<div class="brand-block">
			<p class="footer-title">{constants.siteName}</p>
			<p>{constants.footer.text}</p>
			<p class="copy">© {year} {constants.siteName}. {constants.footer.copyright}</p>
		</div>
		<nav>
			{constants.nav.links.map((link) => (
				<a href={link.href}>{link.label}</a>
			))}
		</nav>
	</div>
</footer>

<style>
	footer {
		width: 100%;
		background: rgba(26, 32, 44, 0.96);
		color: rgba(232, 238, 245, 0.82);
		margin-top: 1rem;
		border-top: 1px solid rgba(184, 134, 11, 0.18);
		box-shadow: 0 -10px 24px rgba(26, 32, 44, 0.15);
	}

	.inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 2rem var(--page-pad);
	}

	.brand-block {
		display: grid;
		gap: 0.38rem;
	}

	.footer-title {
		font-size: 1.08rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--primary-strong);
	}

	p {
		margin: 0;
		line-height: 1.7;
		color: rgba(232, 238, 245, 0.74);
	}

	.copy {
		color: var(--muted);
		font-size: 0.8rem;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	nav a {
		color: rgba(232, 238, 245, 0.82);
		text-decoration: none;
		padding: 0.52rem 0.8rem;
		border-radius: 999px;
		border: 1px solid rgba(184, 134, 11, 0.18);
		background: rgba(37, 46, 63, 0.8);
	}

	nav a:hover {
		border-color: rgba(184, 134, 11, 0.3);
		background: rgba(74, 155, 149, 0.14);
		color: var(--primary-strong);
	}
</style>
