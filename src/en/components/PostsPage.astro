---
import { getCollection } from 'astro:content';
import constants from '../constants.json';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const articles = posts.filter((post) => post.data.kind === 'article');
const shorts = posts.filter((post) => post.data.kind === 'short');
---

<section class="page">
	<div class="page-header">
		<div>
			<h1>{constants.postsPage.title}</h1>
			<p class="intro">{constants.postsPage.intro}</p>
		</div>
		<div class="summary-badges" aria-label="Content summary">
			<span>{articles.length} articles</span>
			<span>{shorts.length} short notes</span>
		</div>
	</div>

	<section class="section-block" aria-labelledby="articles-heading">
		<div class="section-header">
			<h2 id="articles-heading">{constants.postsPage.articles}</h2>
		</div>
		{articles.length === 0 ? (
			<p class="empty">{constants.postsPage.empty}</p>
		) : (
			<ul class="articles">
				{articles.map((post) => (
					<li>
						<a href={`/posts/${post.id}`}>
							<div class="meta-row">
								<em>{constants.kinds.article}</em>
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</time>
							</div>
							<strong>{post.data.title}</strong>
							<span>{post.data.description}</span>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>

	<section class="section-block" aria-labelledby="shorts-heading">
		<div class="section-header">
			<h2 id="shorts-heading">{constants.postsPage.shorts}</h2>
		</div>
		{shorts.length === 0 ? (
			<p class="empty">{constants.postsPage.empty}</p>
		) : (
			<ul class="shorts">
				{shorts.map((post) => (
					<li>
						<a href={`/posts/${post.id}`}>
							<em>{constants.kinds.short}</em>
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'short',
									day: 'numeric',
								})}
							</time>
							<strong>{post.data.title}</strong>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>
</section>

<style>
	.page {
		padding-top: 2.6rem;
	}

	.page-header {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1rem;
		margin-bottom: 1.8rem;
		padding: 1.3rem 1.4rem;
		border: 1px solid rgba(15, 23, 42, 0.08);
		border-radius: 1.4rem;
		background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(239,245,247,0.9));
		box-shadow: 0 18px 30px rgba(15, 23, 42, 0.04);
	}

	h1 {
		margin: 0 0 0.7rem;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(2.6rem, 4vw, 4rem);
		line-height: 1.02;
		color: var(--primary-strong);
	}

	.intro {
		margin: 0;
		max-width: 40rem;
		color: var(--ink-soft);
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.summary-badges {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.55rem;
	}

	.summary-badges span {
		display: inline-flex;
		align-items: center;
		padding: 0.48rem 0.8rem;
		border-radius: 999px;
		background: rgba(27, 125, 118, 0.08);
		border: 1px solid rgba(27, 125, 118, 0.18);
		color: var(--primary);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.section-block {
		margin-bottom: 2.2rem;
	}

	.section-header {
		margin-bottom: 0.8rem;
	}

	h2 {
		margin: 0;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(1.8rem, 2vw, 2.4rem);
		color: var(--primary-strong);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	a {
		display: grid;
		gap: 0.32rem;
		text-decoration: none;
		color: inherit;
		background: rgba(255,255,255,0.72);
		border: 1px solid rgba(15, 23, 42, 0.08);
		border-radius: 1rem;
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	a:hover {
		transform: translateY(-1px);
		box-shadow: 0 12px 24px rgba(15, 23, 42, 0.06);
		border-color: rgba(27, 125, 118, 0.2);
	}

	.articles {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.articles a {
		padding: 1.2rem 1.25rem;
		border-inline-start: 4px solid var(--primary);
		min-height: 9.6rem;
	}

	.shorts {
		display: grid;
		gap: 0.7rem;
	}

	.shorts a {
		grid-template-columns: auto auto 1fr;
		align-items: center;
		gap: 0.9rem;
		padding: 0.8rem 0.95rem;
		border-inline-start: 3px solid var(--accent);
	}

	.meta-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
	}

	em {
		font-style: normal;
		color: #9a7422;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 700;
	}

	time {
		color: var(--accent);
		font-size: 0.8rem;
	}

	strong {
		color: var(--primary-strong);
		font-size: 1.08rem;
		line-height: 1.4;
	}

	span {
		color: var(--muted);
		line-height: 1.6;
	}

	.empty {
		margin: 0;
		padding: 1rem 0;
		color: var(--muted);
	}

	@media (max-width: 840px) {
		.page-header {
			flex-direction: column;
			align-items: flex-start;
		}

		.summary-badges {
			justify-content: flex-start;
		}

		.articles {
			grid-template-columns: 1fr;
		}

		.shorts a {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
