---
import { getCollection } from 'astro:content';
import constants from '../constants.json';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const articles = posts.filter((post) => post.data.kind === 'article');
const shorts = posts.filter((post) => post.data.kind === 'short');
---

<section class="page">
	<div class="page-header">
		<div class="header-content">
			<h1>{constants.postsPage.title}</h1>
			<p class="intro">{constants.postsPage.intro}</p>
		</div>
		<div class="stats-badge">
			<div class="stat-item">
				<span class="stat-number">{articles.length}</span>
				<span class="stat-label">Articles</span>
			</div>
			<div class="stat-item">
				<span class="stat-number">{shorts.length}</span>
				<span class="stat-label">Notes</span>
			</div>
		</div>
	</div>

	<section class="section-block" aria-labelledby="articles-heading">
		<div class="section-header">
			<h2 id="articles-heading">{constants.postsPage.articles}</h2>
		</div>
		{articles.length === 0 ? (
			<p class="empty">{constants.postsPage.empty}</p>
		) : (
			<ul class="articles">
				{articles.map((post, index) => (
					<li class:list={['article-item', `article-tone-${(index % 3) + 1}`]}>
						<a href={`/posts/${post.id}`}>
							<div class="article-number">{String(index + 1).padStart(2, '0')}</div>
							<div class="article-content">
								<div class="meta-row">
									<em>{constants.kinds.article}</em>
									<time datetime={post.data.pubDate.toISOString()}>
										{post.data.pubDate.toLocaleDateString('en-US', {
											year: 'numeric',
											month: 'long',
											day: 'numeric',
										})}
									</time>
								</div>
								<strong>{post.data.title}</strong>
								<span>{post.data.description}</span>
							</div>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>

	<section class="section-block" aria-labelledby="shorts-heading">
		<div class="section-header">
			<h2 id="shorts-heading">{constants.postsPage.shorts}</h2>
		</div>
		{shorts.length === 0 ? (
			<p class="empty">{constants.postsPage.empty}</p>
		) : (
			<ul class="shorts">
				{shorts.map((post, index) => (
					<li class:list={['short-item', `short-tone-${(index % 2) + 1}`]}>
						<a href={`/posts/${post.id}`}>
							<span class="short-index">{index + 1}</span>
							<div class="short-content">
								<em>{constants.kinds.short}</em>
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'short',
										day: 'numeric',
									})}
								</time>
								<strong>{post.data.title}</strong>
							</div>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>
</section>

<style>
	.page {
		padding-top: 2.4rem;
	}

	.page-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
		margin-bottom: 2.5rem;
		padding: 2rem 2.5rem;
		border: 1px solid rgba(138, 155, 179, 0.1);
		border-radius: 1.5rem;
		background: linear-gradient(135deg, rgba(50, 62, 82, 0.98), rgba(61, 74, 94, 0.96));
		box-shadow: var(--shadow-card);
		position: relative;
		overflow: hidden;
	}

	.page-header::before {
		content: "";
		position: absolute;
		top: 0;
		right: 0;
		width: 200px;
		height: 200px;
		background: radial-gradient(circle, rgba(74, 155, 149, 0.08) 0%, transparent 70%);
		pointer-events: none;
	}

	.header-content {
		flex: 1;
	}

	h1 {
		margin: 0 0 0.8rem;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(2.8rem, 4vw, 4.2rem);
		line-height: 1.02;
		color: var(--primary-strong);
	}

	.intro {
		margin: 0;
		max-width: 40rem;
		color: var(--ink-soft);
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.stats-badge {
		display: flex;
		gap: 1.5rem;
		position: relative;
		z-index: 1;
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3rem;
		padding: 1rem 1.5rem;
		background: rgba(40, 52, 70, 0.6);
		border-radius: 1rem;
		border: 1px solid rgba(138, 155, 179, 0.15);
		min-width: 100px;
	}

	.stat-number {
		font-size: 2rem;
		font-weight: 700;
		color: var(--teal);
		line-height: 1;
		font-family: "Cormorant Garamond", Georgia, serif;
	}

	.stat-label {
		font-size: 0.75rem;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 600;
	}

	.section-block {
		margin-bottom: 3rem;
	}

	.section-header {
		margin-bottom: 1.5rem;
		position: relative;
	}

	.section-header::after {
		content: "";
		position: absolute;
		bottom: -0.5rem;
		left: 0;
		width: 60px;
		height: 3px;
		background: linear-gradient(90deg, var(--teal), transparent);
		border-radius: 2px;
	}

	h2 {
		margin: 0;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(2rem, 2.5vw, 2.6rem);
		color: var(--primary-strong);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	a {
		display: flex;
		gap: 1.2rem;
		text-decoration: none;
		color: inherit;
		border: 1px solid rgba(138, 155, 179, 0.1);
		border-radius: 1.2rem;
		transition: all 0.25s ease;
		position: relative;
		overflow: hidden;
	}

	a::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 4px;
		height: 100%;
		background: var(--article-accent, var(--short-accent));
		transition: width 0.25s ease;
	}

	a:hover {
		transform: translateY(-3px);
		box-shadow: 0 20px 40px rgba(30, 36, 48, 0.2);
		border-color: rgba(74, 155, 149, 0.25);
	}

	a:hover::before {
		width: 6px;
	}

	.articles {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 1.2rem;
	}

	.article-item {
		--article-bg: linear-gradient(135deg, rgba(50, 62, 82, 0.98), rgba(61, 74, 94, 0.96));
		--article-accent: var(--teal);
		--article-accent-soft: rgba(74, 155, 149, 0.15);
	}

	.article-tone-2 {
		--article-bg: linear-gradient(135deg, rgba(61, 74, 94, 0.98), rgba(50, 62, 82, 0.96));
		--article-accent: var(--accent-strong);
		--article-accent-soft: rgba(184, 134, 11, 0.15);
	}

	.article-tone-3 {
		--article-bg: linear-gradient(135deg, rgba(50, 62, 82, 0.98), rgba(61, 74, 94, 0.96));
		--article-accent: var(--primary);
		--article-accent-soft: rgba(184, 134, 11, 0.12);
	}

	.articles a {
		padding: 1.5rem 1.5rem 1.5rem 2.7rem;
		background: var(--article-bg);
		min-height: 180px;
		align-items: flex-start;
	}

	.article-number {
		font-size: 3rem;
		font-weight: 700;
		color: var(--article-accent);
		line-height: 1;
		font-family: "Cormorant Garamond", Georgia, serif;
		opacity: 0.15;
		position: absolute;
		top: 0.5rem;
		right: 1rem;
		transition: opacity 0.25s ease;
	}

	a:hover .article-number {
		opacity: 0.25;
	}

	.article-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.meta-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.8rem;
	}

	em {
		font-style: normal;
		color: var(--article-accent);
		background: var(--article-accent-soft);
		padding: 0.3rem 0.6rem;
		border-radius: 999px;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 700;
	}

	time {
		color: var(--muted);
		font-size: 0.8rem;
	}

	strong {
		color: var(--primary-strong);
		font-size: 1.15rem;
		line-height: 1.4;
		font-weight: 600;
	}

	span {
		color: var(--ink-soft);
		line-height: 1.6;
		font-size: 0.95rem;
	}

	.shorts {
		display: grid;
		gap: 0.8rem;
	}

	.short-item {
		--short-bg: rgba(50, 62, 82, 0.95);
		--short-accent: var(--teal);
	}

	.short-tone-2 {
		--short-bg: rgba(61, 74, 94, 0.95);
		--short-accent: var(--accent-strong);
	}

	.shorts a {
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.2rem 1rem 2.2rem;
		background: var(--short-bg);
	}

	.short-index {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--short-accent);
		line-height: 1;
		font-family: "Cormorant Garamond", Georgia, serif;
		opacity: 0.3;
	}

	.short-content {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.empty {
		margin: 0;
		padding: 2rem 0;
		color: var(--muted);
		text-align: center;
		font-style: italic;
	}

	@media (max-width: 840px) {
		.page-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.5rem;
		}

		.stats-badge {
			width: 100%;
			justify-content: flex-start;
		}

		.articles {
			grid-template-columns: 1fr;
		}

		.shorts a {
			grid-template-columns: auto 1fr;
			gap: 0.8rem;
		}
	}
</style>
