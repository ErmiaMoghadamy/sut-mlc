---
import constants from '../constants.json';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header>
	<div class="bar">
		<div class="inner">
			<a class="brand" href={constants.homeHref}>
				<span class="emblem-wrap" aria-hidden="true">
					<svg class="emblem" viewBox="0 0 64 64" aria-hidden="true">
						<g fill="#d4aa52">
							<rect x="18" y="18" width="28" height="28"></rect>
							<rect x="18" y="18" width="28" height="28" transform="rotate(45 32 32)"></rect>
						</g>
						<g fill="#091d2e">
							<rect x="23" y="23" width="18" height="18"></rect>
							<rect x="23" y="23" width="18" height="18" transform="rotate(45 32 32)"></rect>
						</g>
						<circle cx="32" cy="32" r="6" fill="#1b8e86"></circle>
						<circle cx="32" cy="32" r="2.5" fill="#f6f0e8"></circle>
					</svg>
				</span>
				<span class="names">
					<span class="name">{constants.siteName}</span>
					<span class="mark">{constants.siteMark}</span>
				</span>
			</a>

			<nav class="links" aria-label="Primary">
				{constants.nav.links.map((link) => (
					<a href={link.href} class:list={[{ current: path === link.href || (link.href !== '/' && path.startsWith(link.href)) }]}>
						{link.label}
					</a>
				))}
				<a class="lang" href={constants.nav.otherLangHref} lang="fa" dir="rtl">
					{constants.nav.otherLang}
				</a>
			</nav>

			<button class="burger" type="button" aria-expanded="false" aria-controls="site-menu">
				<span class="bars" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
				<span class="label">{constants.nav.menu}</span>
			</button>
		</div>
	</div>
</header>

<div id="site-menu" class="drawer" hidden>
	<div class="drawer-panel">
		<div class="drawer-top">
			<strong>{constants.siteName}</strong>
			<button class="close" type="button">{constants.nav.close}</button>
		</div>
		<nav>
			{constants.nav.links.map((link) => (
				<a href={link.href}>{link.label}</a>
			))}
			<a class="lang" href={constants.nav.otherLangHref} lang="fa" dir="rtl">
				{constants.nav.otherLang}
			</a>
		</nav>
	</div>
</div>

<script>
	const burger = document.querySelector('.burger');
	const drawer = document.querySelector('#site-menu');
	const closeBtn = document.querySelector('.close');

	function openMenu() {
		if (!(burger instanceof HTMLButtonElement) || !(drawer instanceof HTMLElement)) return;
		drawer.hidden = false;
		burger.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
	}

	function closeMenu() {
		if (!(burger instanceof HTMLButtonElement) || !(drawer instanceof HTMLElement)) return;
		drawer.hidden = true;
		burger.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	}

	burger?.addEventListener('click', () => {
		if (drawer instanceof HTMLElement && drawer.hidden) openMenu();
		else closeMenu();
	});
	closeBtn?.addEventListener('click', closeMenu);
	drawer?.addEventListener('click', (event) => {
		if (event.target === drawer) closeMenu();
	});
	window.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeMenu();
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: blur(14px);
	}

	.bar {
		background: rgba(26, 32, 44, 0.96);
		border-bottom: 1px solid rgba(184, 134, 11, 0.2);
		box-shadow: 0 12px 26px rgba(26, 32, 44, 0.2);
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		width: 100%;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 0.8rem var(--page-pad);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		color: var(--primary);
		text-decoration: none;
		min-width: 0;
		transition: opacity 0.2s ease;
	}

	.brand:hover .emblem-wrap {
		transform: scale(1.05) rotate(5deg);
		box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 0 25px rgba(74, 155, 149, 0.2);
	}

	.emblem-wrap {
		display: grid;
		place-items: center;
		width: 2.85rem;
		height: 2.85rem;
		border-radius: 14px;
		background: linear-gradient(135deg, rgba(74, 155, 149, 0.12), rgba(184, 134, 11, 0.1));
		border: 1px solid rgba(138, 155, 179, 0.2);
		box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 0 20px rgba(74, 155, 149, 0.1);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.emblem {
		width: 2.15rem;
		height: 2.15rem;
		flex-shrink: 0;
	}

	.names {
		display: grid;
		gap: 0.08rem;
		min-width: 0;
	}

	.name {
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: 1.8rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 1;
		color: var(--primary-strong);
	}

	.mark {
		color: var(--accent-strong);
		font-size: 0.66rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		font-weight: 700;
	}

	.links {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-shrink: 0;
	}

	.links a,
	.drawer nav a {
		text-decoration: none;
		font-size: 0.92rem;
		padding: 0.58rem 0.9rem;
		border-radius: 999px;
		border: 1px solid transparent;
		color: rgba(232, 238, 245, 0.85);
		font-weight: 500;
		transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}

	.links a:hover,
	.links a.current {
		background: rgba(74, 155, 149, 0.12);
		border-color: rgba(184, 134, 11, 0.25);
		color: var(--primary-strong);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(74, 155, 149, 0.15);
	}

	.lang {
		border-color: rgba(184, 134, 11, 0.25) !important;
		color: var(--accent-strong) !important;
		background: rgba(184, 134, 11, 0.08);
	}

	.burger {
		display: none;
		align-items: center;
		gap: 0.55rem;
		background: rgba(37, 46, 63, 0.85);
		color: var(--primary);
		border: 1px solid rgba(138, 155, 179, 0.2);
		border-radius: 999px;
		padding: 0.52rem 0.8rem;
		cursor: pointer;
		font: inherit;
	}

	.bars {
		display: grid;
		gap: 3px;
	}

	.bars span {
		display: block;
		width: 1.1rem;
		height: 2px;
		background: var(--primary);
		border-radius: 2px;
	}

	.drawer {
		position: fixed;
		inset: 0;
		z-index: 40;
		background: rgba(26, 32, 44, 0.4);
		display: grid;
		justify-items: end;
	}

	.drawer[hidden] {
		display: none;
	}

	.drawer-panel {
		width: min(22rem, 100%);
		height: 100%;
		background: linear-gradient(180deg, rgba(37, 46, 63, 1) 0%, rgba(45, 56, 74, 1) 100%);
		color: var(--ink);
		padding: 1.2rem 1.3rem 2rem;
		box-shadow: -18px 0 35px rgba(26, 32, 44, 0.35);
	}

	.drawer-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.3rem;
	}

	.close {
		background: transparent;
		border: 1px solid rgba(11, 34, 56, 0.12);
		color: inherit;
		border-radius: 999px;
		padding: 0.35rem 0.8rem;
		cursor: pointer;
		font: inherit;
	}

	.drawer nav {
		display: grid;
		gap: 0.55rem;
	}

	.drawer nav a {
		display: block;
		font-size: 1.05rem;
		padding: 0.72rem 0.8rem;
		border: 1px solid rgba(138, 155, 179, 0.12);
		background: rgba(255,255,255,0.04);
	}

	@media (max-width: 840px) {
		.links {
			display: none;
		}

		.burger {
			display: inline-flex;
		}
	}
</style>
