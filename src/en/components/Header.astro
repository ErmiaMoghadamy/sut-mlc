---
import constants from '../constants.json';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header>
	<div class="khatam" aria-hidden="true"></div>
	<div class="bar">
		<div class="inner">
			<a class="brand" href={constants.homeHref}>
				<span class="emblem-wrap" aria-hidden="true">
					<svg class="emblem" viewBox="0 0 64 64" aria-hidden="true">
						<g fill="#d9b76c">
							<rect x="18" y="18" width="28" height="28"></rect>
							<rect x="18" y="18" width="28" height="28" transform="rotate(45 32 32)"></rect>
						</g>
						<g fill="#071428">
							<rect x="23" y="23" width="18" height="18"></rect>
							<rect x="23" y="23" width="18" height="18" transform="rotate(45 32 32)"></rect>
						</g>
						<circle cx="32" cy="32" r="6" fill="#1c8d87"></circle>
						<circle cx="32" cy="32" r="2.5" fill="#f9f3e6"></circle>
					</svg>
				</span>
				<span class="names">
					<span class="name">{constants.siteName}</span>
					<span class="mark">{constants.siteMark}</span>
				</span>
			</a>

			<nav class="links" aria-label="Primary">
				{constants.nav.links.map((link) => (
					<a href={link.href} class:list={[{ current: path === link.href || (link.href !== '/' && path.startsWith(link.href)) }]}>
						{link.label}
					</a>
				))}
				<a class="lang" href={constants.nav.otherLangHref} lang="fa" dir="rtl">
					{constants.nav.otherLang}
				</a>
			</nav>

			<button class="burger" type="button" aria-expanded="false" aria-controls="site-menu">
				<span class="bars" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
				<span class="label">{constants.nav.menu}</span>
			</button>
		</div>
	</div>
	<div class="khatam" aria-hidden="true"></div>
</header>

<div id="site-menu" class="drawer" hidden>
	<div class="drawer-panel">
		<div class="drawer-top">
			<strong>{constants.siteName}</strong>
			<button class="close" type="button">{constants.nav.close}</button>
		</div>
		<nav>
			{constants.nav.links.map((link) => (
				<a href={link.href}>{link.label}</a>
			))}
			<a class="lang" href={constants.nav.otherLangHref} lang="fa" dir="rtl">
				{constants.nav.otherLang}
			</a>
		</nav>
	</div>
</div>

<script>
	const burger = document.querySelector('.burger');
	const drawer = document.querySelector('#site-menu');
	const closeBtn = document.querySelector('.close');

	function openMenu() {
		if (!(burger instanceof HTMLButtonElement) || !(drawer instanceof HTMLElement)) return;
		drawer.hidden = false;
		burger.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
	}

	function closeMenu() {
		if (!(burger instanceof HTMLButtonElement) || !(drawer instanceof HTMLElement)) return;
		drawer.hidden = true;
		burger.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	}

	burger?.addEventListener('click', () => {
		if (drawer instanceof HTMLElement && drawer.hidden) openMenu();
		else closeMenu();
	});
	closeBtn?.addEventListener('click', closeMenu);
	drawer?.addEventListener('click', (event) => {
		if (event.target === drawer) closeMenu();
	});
	window.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeMenu();
	});
</script>

<style>
	header {
		width: 100%;
		position: relative;
		z-index: 2;
		color: #f6eddb;
		box-shadow: 0 18px 44px rgba(7, 20, 40, 0.18);
	}

	.khatam {
		height: 12px;
		background-color: #071428;
		background-image: url('/patterns/khatam-band.svg');
		background-repeat: repeat-x;
		background-size: 52px 12px;
	}

	.bar {
		background:
			radial-gradient(circle at 14% 120%, rgba(28, 141, 135, 0.32), transparent 35%),
			radial-gradient(circle at 86% -20%, rgba(217, 183, 108, 0.18), transparent 34%),
			#071428;
		background-image:
			radial-gradient(circle at 14% 120%, rgba(28, 141, 135, 0.32), transparent 35%),
			radial-gradient(circle at 86% -20%, rgba(217, 183, 108, 0.18), transparent 34%),
			url('/patterns/girih.svg');
		background-size: auto, auto, 160px 160px;
		border-block: 1px solid rgba(217, 183, 108, 0.22);
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		width: 100%;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 1rem var(--page-pad);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		color: inherit;
		text-decoration: none;
		min-width: 0;
	}

	.emblem-wrap {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(217, 183, 108, 0.3), transparent 70%);
		box-shadow: 0 0 0 1px rgba(217, 183, 108, 0.22);
	}

	.emblem {
		width: 2.5rem;
		height: 2.5rem;
		flex-shrink: 0;
	}

	.names {
		display: grid;
		gap: 0.14rem;
		min-width: 0;
	}

	.name {
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: 1.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1;
	}

	.mark {
		color: #9fe1d8;
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.links {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
	}

	.links a,
	.drawer nav a {
		text-decoration: none;
		font-size: 0.92rem;
		padding: 0.46rem 0.92rem;
		border-radius: 999px;
		border: 1px solid transparent;
		color: #f5ead0;
		transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}

	.links a:hover,
	.links a.current {
		background: rgba(217, 183, 108, 0.12);
		border-color: rgba(217, 183, 108, 0.4);
	}

	.lang {
		border-color: rgba(28, 141, 135, 0.7) !important;
		color: #9fe1d8 !important;
	}

	.burger {
		display: none;
		align-items: center;
		gap: 0.55rem;
		background: rgba(217, 183, 108, 0.1);
		color: #f5ead0;
		border: 1px solid rgba(217, 183, 108, 0.34);
		border-radius: 999px;
		padding: 0.48rem 0.8rem;
		cursor: pointer;
		font: inherit;
	}

	.bars {
		display: grid;
		gap: 3px;
	}

	.bars span {
		display: block;
		width: 1.05rem;
		height: 2px;
		background: #f5ead0;
	}

	.drawer {
		position: fixed;
		inset: 0;
		z-index: 40;
		background: rgba(7, 20, 40, 0.6);
		display: grid;
		justify-items: end;
	}

	.drawer[hidden] {
		display: none;
	}

	.drawer-panel {
		width: min(22rem, 100%);
		height: 100%;
		background: #071428;
		color: #f5ead0;
		padding: 1.25rem 1.35rem 2rem;
		box-shadow: -18px 0 40px rgba(7, 20, 40, 0.28);
	}

	.drawer-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.4rem;
	}

	.close {
		background: transparent;
		border: 1px solid rgba(217, 183, 108, 0.38);
		color: inherit;
		border-radius: 999px;
		padding: 0.35rem 0.8rem;
		cursor: pointer;
		font: inherit;
	}

	.drawer nav {
		display: grid;
		gap: 0.55rem;
	}

	.drawer nav a {
		display: block;
		font-size: 1.1rem;
		padding: 0.7rem 0.85rem;
		border: 1px solid rgba(217, 183, 108, 0.22);
	}

	@media (max-width: 840px) {
		.links {
			display: none;
		}

		.burger {
			display: inline-flex;
		}
	}
</style>
