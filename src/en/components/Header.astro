---
import constants from '../constants.json';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header>
	<div class="bar">
		<div class="inner">
			<a class="brand" href={constants.homeHref}>
				<span class="emblem-wrap" aria-hidden="true">
					<svg class="emblem" viewBox="0 0 64 64" aria-hidden="true">
						<g fill="#d4aa52">
							<rect x="18" y="18" width="28" height="28"></rect>
							<rect x="18" y="18" width="28" height="28" transform="rotate(45 32 32)"></rect>
						</g>
						<g fill="#091d2e">
							<rect x="23" y="23" width="18" height="18"></rect>
							<rect x="23" y="23" width="18" height="18" transform="rotate(45 32 32)"></rect>
						</g>
						<circle cx="32" cy="32" r="6" fill="#1b8e86"></circle>
						<circle cx="32" cy="32" r="2.5" fill="#f6f0e8"></circle>
					</svg>
				</span>
				<span class="names">
					<span class="name">{constants.siteName}</span>
					<span class="mark">{constants.siteMark}</span>
				</span>
			</a>

			<nav class="links" aria-label="Primary">
				{constants.nav.links.map((link) => (
					<a href={link.href} class:list={[{ current: path === link.href || (link.href !== '/' && path.startsWith(link.href)) }]}>
						{link.label}
					</a>
				))}
				<a class="lang" href={constants.nav.otherLangHref} lang="fa" dir="rtl">
					{constants.nav.otherLang}
				</a>
			</nav>

			<button class="burger" type="button" aria-expanded="false" aria-controls="site-menu">
				<span class="bars" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
				<span class="label">{constants.nav.menu}</span>
			</button>
		</div>
	</div>
</header>

<div id="site-menu" class="drawer" hidden>
	<div class="drawer-panel">
		<div class="drawer-top">
			<strong>{constants.siteName}</strong>
			<button class="close" type="button">{constants.nav.close}</button>
		</div>
		<nav>
			{constants.nav.links.map((link) => (
				<a href={link.href}>{link.label}</a>
			))}
			<a class="lang" href={constants.nav.otherLangHref} lang="fa" dir="rtl">
				{constants.nav.otherLang}
			</a>
		</nav>
	</div>
</div>

<script>
	const burger = document.querySelector('.burger');
	const drawer = document.querySelector('#site-menu');
	const closeBtn = document.querySelector('.close');

	function openMenu() {
		if (!(burger instanceof HTMLButtonElement) || !(drawer instanceof HTMLElement)) return;
		drawer.hidden = false;
		burger.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
	}

	function closeMenu() {
		if (!(burger instanceof HTMLButtonElement) || !(drawer instanceof HTMLElement)) return;
		drawer.hidden = true;
		burger.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	}

	burger?.addEventListener('click', () => {
		if (drawer instanceof HTMLElement && drawer.hidden) openMenu();
		else closeMenu();
	});
	closeBtn?.addEventListener('click', closeMenu);
	drawer?.addEventListener('click', (event) => {
		if (event.target === drawer) closeMenu();
	});
	window.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeMenu();
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: blur(12px);
	}

	.bar {
		background: rgba(9, 21, 34, 0.92);
		border-bottom: 1px solid rgba(212, 170, 82, 0.2);
		box-shadow: 0 12px 32px rgba(7, 20, 40, 0.18);
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		width: 100%;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 0.9rem var(--page-pad);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		color: #f7f1e8;
		text-decoration: none;
		min-width: 0;
	}

	.emblem-wrap {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(212, 170, 82, 0.18), transparent 70%);
		border: 1px solid rgba(212, 170, 82, 0.24);
	}

	.emblem {
		width: 2.2rem;
		height: 2.2rem;
		flex-shrink: 0;
	}

	.names {
		display: grid;
		gap: 0.08rem;
		min-width: 0;
	}

	.name {
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: 1.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		line-height: 1;
	}

	.mark {
		color: #a9d7d1;
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.links {
		display: flex;
		align-items: center;
		gap: 0.32rem;
		flex-shrink: 0;
	}

	.links a,
	.drawer nav a {
		text-decoration: none;
		font-size: 0.92rem;
		padding: 0.52rem 0.85rem;
		border-radius: 999px;
		border: 1px solid transparent;
		color: #edf1f4;
		transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}

	.links a:hover,
	.links a.current {
		background: rgba(212, 170, 82, 0.14);
		border-color: rgba(212, 170, 82, 0.42);
	}

	.lang {
		border-color: rgba(45, 165, 148, 0.7) !important;
		color: #a9d7d1 !important;
	}

	.burger {
		display: none;
		align-items: center;
		gap: 0.55rem;
		background: rgba(212, 170, 82, 0.1);
		color: #f5f1ea;
		border: 1px solid rgba(212, 170, 82, 0.34);
		border-radius: 999px;
		padding: 0.5rem 0.8rem;
		cursor: pointer;
		font: inherit;
	}

	.bars {
		display: grid;
		gap: 3px;
	}

	.bars span {
		display: block;
		width: 1.1rem;
		height: 2px;
		background: #f5f1ea;
		border-radius: 2px;
	}

	.drawer {
		position: fixed;
		inset: 0;
		z-index: 40;
		background: rgba(7, 20, 40, 0.58);
		display: grid;
		justify-items: end;
	}

	.drawer[hidden] {
		display: none;
	}

	.drawer-panel {
		width: min(22rem, 100%);
		height: 100%;
		background: linear-gradient(180deg, #0a1828, #0d2138);
		color: #edf1f4;
		padding: 1.2rem 1.3rem 2rem;
		box-shadow: -18px 0 35px rgba(7, 20, 40, 0.28);
	}

	.drawer-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.3rem;
	}

	.close {
		background: transparent;
		border: 1px solid rgba(212, 170, 82, 0.42);
		color: inherit;
		border-radius: 999px;
		padding: 0.35rem 0.8rem;
		cursor: pointer;
		font: inherit;
	}

	.drawer nav {
		display: grid;
		gap: 0.55rem;
	}

	.drawer nav a {
		display: block;
		font-size: 1.05rem;
		padding: 0.72rem 0.8rem;
		border: 1px solid rgba(212, 170, 82, 0.18);
	}

	@media (max-width: 840px) {
		.links {
			display: none;
		}

		.burger {
			display: inline-flex;
		}
	}
</style>
