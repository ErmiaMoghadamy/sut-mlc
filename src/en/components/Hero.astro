---
import constants from '../constants.json';
---

<section class="hero">
	<div class="hero-content">
		<p class="kicker">{constants.hero.kicker}</p>
		<h1>{constants.hero.title}</h1>
		<p class="lead">{constants.hero.subtitle}</p>
		<p class="summary">{constants.hero.summary}</p>
		<div class="actions">
			<a class="primary" href={constants.hero.primaryCta.href}>{constants.hero.primaryCta.label}</a>
			<a class="secondary" href={constants.hero.secondaryCta.href}>{constants.hero.secondaryCta.label}</a>
		</div>
	</div>

	<div class="hero-image">
		<div class="image-wrapper">
			<div class="image-placeholder">
				<svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
					<circle cx="200" cy="200" r="180" fill="rgba(74, 155, 149, 0.1)"/>
					<circle cx="200" cy="200" r="140" fill="rgba(184, 134, 11, 0.08)"/>
					<circle cx="200" cy="200" r="100" fill="rgba(74, 155, 149, 0.15)"/>
					<g transform="translate(140, 140)">
						<rect x="20" y="20" width="80" height="80" rx="8" fill="rgba(74, 155, 149, 0.3)"/>
						<rect x="35" y="35" width="50" height="50" rx="4" fill="rgba(184, 134, 11, 0.4)"/>
						<circle cx="60" cy="60" r="15" fill="rgba(232, 238, 245, 0.6)"/>
					</g>
					<g transform="translate(200, 180)">
						<rect x="20" y="20" width="60" height="60" rx="6" fill="rgba(74, 155, 149, 0.25)"/>
						<rect x="30" y="30" width="40" height="40" rx="3" fill="rgba(184, 134, 11, 0.35)"/>
					</g>
					<g transform="translate(100, 200)">
						<rect x="20" y="20" width="50" height="50" rx="5" fill="rgba(74, 155, 149, 0.2)"/>
						<rect x="28" y="28" width="34" height="34" rx="2" fill="rgba(184, 134, 11, 0.3)"/>
					</g>
				</svg>
			</div>
		</div>
	</div>

	<div class="stats-row">
		{constants.hero.panelItems.map((item) => (
			<div class="stat-item">
				<span class="stat-value">{item.value}</span>
				<span class="stat-label">{item.meta}</span>
			</div>
		))}
	</div>
</section>

<style>
	.hero {
		padding: 3rem 0 4rem;
		position: relative;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 3rem;
		align-items: center;
	}

	.hero::before {
		content: "";
		position: absolute;
		top: -20%;
		right: -10%;
		width: 50%;
		height: 140%;
		background: radial-gradient(ellipse, rgba(74, 155, 149, 0.08) 0%, transparent 60%);
		pointer-events: none;
	}

	.hero::after {
		content: "";
		position: absolute;
		bottom: -10%;
		left: -5%;
		width: 40%;
		height: 100%;
		background: radial-gradient(ellipse, rgba(184, 134, 11, 0.06) 0%, transparent 50%);
		pointer-events: none;
	}

	.hero-content {
		max-width: 42rem;
		position: relative;
		z-index: 1;
	}

	.kicker {
		margin: 0 0 1rem;
		color: var(--accent-strong);
		font-size: 0.75rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		font-weight: 800;
	}

	h1 {
		margin: 0 0 1.2rem;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(3.5rem, 7vw, 6rem);
		font-weight: 700;
		line-height: 0.92;
		letter-spacing: -0.04em;
		color: var(--primary-strong);
	}

	.lead {
		margin: 0 0 1rem;
		max-width: 38rem;
		font-size: clamp(1.15rem, 1.8vw, 1.35rem);
		line-height: 1.65;
		color: var(--ink);
	}

	.summary {
		margin: 0 0 2rem;
		max-width: 38rem;
		font-size: 1.05rem;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3.2rem;
		padding: 0.85rem 1.5rem;
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
		transition: all 0.25s ease;
	}

	.primary {
		background: linear-gradient(135deg, var(--teal) 0%, #3d8a84 100%);
		color: var(--primary-strong);
		box-shadow: 0 8px 20px rgba(74, 155, 149, 0.25);
	}

	.primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 28px rgba(74, 155, 149, 0.35);
	}

	.secondary {
		background: transparent;
		color: var(--primary);
		border: 1.5px solid rgba(184, 134, 11, 0.4);
	}

	.secondary:hover {
		background: rgba(184, 134, 11, 0.1);
		border-color: var(--accent-strong);
		color: var(--primary-strong);
		transform: translateY(-2px);
	}

	.hero-image {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.image-wrapper {
		position: relative;
		width: 320px;
		height: 320px;
		animation: float 6s ease-in-out infinite;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-20px); }
	}

	.image-placeholder {
		width: 100%;
		height: 100%;
		position: relative;
	}

	.image-placeholder svg {
		width: 100%;
		height: 100%;
		filter: drop-shadow(0 20px 40px rgba(74, 155, 149, 0.15));
	}

	.stats-row {
		grid-column: 1 / -1;
		display: flex;
		gap: 2.5rem;
		margin-top: 3.5rem;
		padding-top: 2.5rem;
		border-top: 1px solid rgba(138, 155, 179, 0.15);
		position: relative;
		z-index: 1;
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.stat-value {
		font-size: 2.2rem;
		font-weight: 700;
		color: var(--primary-strong);
		line-height: 1;
		font-family: "Cormorant Garamond", Georgia, serif;
	}

	.stat-label {
		font-size: 0.88rem;
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 600;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2rem;
			text-align: center;
		}

		.hero-content {
			max-width: 100%;
		}

		.hero-image {
			order: -1;
		}

		.image-wrapper {
			width: 280px;
			height: 280px;
		}

		.actions {
			justify-content: center;
		}

		.stats-row {
			justify-content: center;
		}
	}

	@media (max-width: 760px) {
		.hero {
			padding: 2rem 0 3rem;
		}

		h1 {
			font-size: clamp(2.8rem, 10vw, 4rem);
		}

		.stats-row {
			flex-wrap: wrap;
			gap: 2rem;
			margin-top: 2.5rem;
			padding-top: 2rem;
		}

		.stat-value {
			font-size: 1.8rem;
		}

		.image-wrapper {
			width: 240px;
			height: 240px;
		}
	}
</style>
