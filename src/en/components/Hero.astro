---
import constants from '../constants.json';
---

<section class="hero">
	<div class="hero-inner">
		<div class="hero-copy">
			<p class="kicker">{constants.hero.kicker}</p>
			<h1>{constants.hero.title}</h1>
			<span class="ornament" aria-hidden="true"></span>
			<p class="lead">{constants.hero.subtitle}</p>
			<p class="summary">{constants.hero.summary}</p>
			<div class="actions">
				<a class="primary" href={constants.hero.primaryCta.href}>{constants.hero.primaryCta.label}</a>
				<a class="secondary" href={constants.hero.secondaryCta.href}>{constants.hero.secondaryCta.label}</a>
			</div>
		</div>

		<aside class="info-panel" aria-label={constants.hero.panelTitle}>
			<p class="panel-label">{constants.hero.panelTitle}</p>
			<div class="panel-body">
				{constants.hero.panelItems.map((item) => (
					<div class="panel-item">
						<span class="panel-value">{item.value}</span>
						<span class="panel-meta">{item.meta}</span>
					</div>
				))}
			</div>
		</aside>
	</div>
</section>

<style>
	.hero {
		padding: 3.25rem 0 2.25rem;
	}

	.hero-inner {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(230px, 0.75fr);
		gap: 1.5rem;
		align-items: stretch;
	}

	.hero-copy {
		max-width: 42rem;
		padding: 1.1rem 0;
	}

	.kicker {
		margin: 0 0 0.8rem;
		color: var(--teal-600);
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		font-weight: 700;
	}

	h1 {
		margin: 0;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(3rem, 7vw, 5rem);
		font-weight: 700;
		line-height: 0.95;
		letter-spacing: -0.04em;
		color: #081b2f;
	}

	.ornament {
		display: block;
		width: 5rem;
		height: 0.72rem;
		margin: 1rem 0 1.15rem;
		background: linear-gradient(90deg, transparent, #1c8d87 18%, #d0a74a 50%, #1c8d87 82%, transparent);
		clip-path: polygon(0 50%, 18% 0, 50% 50%, 82% 0, 100% 50%, 82% 100%, 50% 50%, 18% 100%);
	}

	.lead {
		margin: 0;
		max-width: 34rem;
		font-size: 1.18rem;
		line-height: 1.7;
		color: #112a45;
	}

	.summary {
		margin: 1rem 0 0;
		max-width: 35rem;
		font-size: 1.02rem;
		line-height: 1.8;
		color: var(--stone-700);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.7rem;
	}

	.actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.9rem;
		padding: 0.75rem 1.2rem;
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	.actions a:hover {
		transform: translateY(-1px);
	}

	.primary {
		background: linear-gradient(135deg, #071428 0%, #133253 100%);
		color: #f7e2a0;
		box-shadow: 0 14px 22px rgba(8, 27, 47, 0.15);
	}

	.secondary {
		background: rgba(255, 255, 255, 0.4);
		color: #0b2748;
		border: 1px solid rgba(11, 39, 72, 0.13);
	}

	.info-panel {
		padding: 1.2rem 1.15rem 1rem;
		border: 1px solid rgba(28, 141, 135, 0.28);
		border-radius: 1.35rem;
		background: linear-gradient(180deg, rgba(255,255,255,0.72), rgba(244, 228, 166, 0.16));
		box-shadow: 0 24px 42px rgba(15, 30, 48, 0.08);
		backdrop-filter: blur(2px);
	}

	.panel-label {
		margin: 0 0 1rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #1c8d87;
	}

	.panel-body {
		display: grid;
		gap: 0.8rem;
	}

	.panel-item {
		display: flex;
		flex-direction: column;
		gap: 0.12rem;
		padding: 0.9rem 0.95rem;
		border-radius: 1rem;
		background: rgba(255,255,255,0.52);
		border: 1px solid rgba(11, 39, 72, 0.08);
	}

	.panel-value {
		font-size: 1.3rem;
		font-weight: 700;
		color: #0d2138;
	}

	.panel-meta {
		font-size: 0.9rem;
		color: var(--stone-700);
	}

	@media (max-width: 760px) {
		.hero-inner {
			grid-template-columns: 1fr;
		}

		.hero {
			padding-top: 2.4rem;
		}
	}
</style>
