---
import constants from '../constants.json';
---

<section class="hero">
	<div class="hero-inner">
		<div class="hero-copy">
			<p class="kicker">{constants.hero.kicker}</p>
			<h1>{constants.hero.title}</h1>
			<p class="lead">{constants.hero.subtitle}</p>
			<p class="summary">{constants.hero.summary}</p>
			<div class="actions">
				<a class="primary" href={constants.hero.primaryCta.href}>{constants.hero.primaryCta.label}</a>
				<a class="secondary" href={constants.hero.secondaryCta.href}>{constants.hero.secondaryCta.label}</a>
			</div>
		</div>

		<aside class="info-panel" aria-label={constants.hero.panelTitle}>
			<p class="panel-label">{constants.hero.panelTitle}</p>
			<div class="panel-body">
				{constants.hero.panelItems.map((item) => (
					<div class="panel-item">
						<span class="panel-value">{item.value}</span>
						<span class="panel-meta">{item.meta}</span>
					</div>
				))}
			</div>
		</aside>
	</div>
</section>

<style>
	.hero {
		padding: 1.4rem 0 2rem;
	}

	.hero-inner {
		display: grid;
		grid-template-columns: minmax(0, 1.7fr) minmax(230px, 0.85fr);
		gap: var(--space-6);
		align-items: stretch;
		padding: clamp(1.25rem, 2vw, 2rem);
		border: 1px solid rgba(184, 134, 11, 0.18);
		border-radius: 1.7rem;
		background: linear-gradient(135deg, rgba(37, 46, 63, 0.96), rgba(45, 56, 74, 0.92));
		box-shadow: var(--shadow-soft);
	}

	.hero-copy {
		max-width: 42rem;
		padding: 0.6rem 0.2rem;
	}

	.kicker {
		margin: 0 0 0.8rem;
		color: var(--accent-strong);
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-weight: 800;
	}

	h1 {
		margin: 0;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(3.1rem, 6vw, 5.5rem);
		font-weight: 700;
		line-height: 0.9;
		letter-spacing: -0.05em;
		color: var(--primary-strong);
	}

	.lead {
		margin: 1rem 0 0;
		max-width: 35rem;
		font-size: clamp(1.08rem, 1.7vw, 1.28rem);
		line-height: 1.7;
		color: var(--ink);
	}

	.summary {
		margin: 1rem 0 0;
		max-width: 35rem;
		font-size: 1.02rem;
		line-height: 1.8;
		color: var(--ink-soft);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.8rem;
	}

	.actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.95rem;
		padding: 0.78rem 1.25rem;
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	.actions a:hover {
		transform: translateY(-1px);
	}

	.primary {
		background: linear-gradient(135deg, rgba(26, 32, 44, 0.9) 0%, rgba(37, 46, 63, 0.95) 100%);
		color: var(--primary-strong);
		box-shadow: 0 14px 24px rgba(26, 32, 44, 0.25);
	}

	.secondary {
		background: rgba(255, 255, 255, 0.06);
		color: var(--primary);
		border: 1px solid rgba(184, 134, 11, 0.2);
	}

	.info-panel {
		padding: 1.1rem 1rem 0.9rem;
		border: 1px solid rgba(74, 155, 149, 0.2);
		border-radius: 1.3rem;
		background: linear-gradient(180deg, rgba(45, 56, 74, 0.96), rgba(37, 46, 63, 0.96));
		box-shadow: var(--shadow-card);
	}

	.panel-label {
		margin: 0 0 0.9rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--teal);
	}

	.panel-body {
		display: grid;
		gap: 0.8rem;
	}

	.panel-item {
		display: flex;
		flex-direction: column;
		gap: 0.12rem;
		padding: 0.95rem 1rem;
		border-radius: 1rem;
		background: linear-gradient(180deg, rgba(45, 56, 74, 0.96), rgba(37, 46, 63, 0.96));
		border: 1px solid rgba(184, 134, 11, 0.1);
	}

	.panel-value {
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--primary-strong);
	}

	.panel-meta {
		font-size: 0.88rem;
		color: var(--ink-soft);
	}

	@media (max-width: 760px) {
		.hero-inner {
			grid-template-columns: 1fr;
		}

		.hero {
			padding-top: 1.5rem;
		}
	}
</style>
