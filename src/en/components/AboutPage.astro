---
import constants from '../constants.json';

const { leaders, core, mission, summaryItems } = constants.about;
---

<section class="about">
	<div class="page-header">
		<div class="header-topline">
			<span class="eyebrow">{constants.about.title}</span>
			<span class="status-pill">{constants.about.status}</span>
		</div>

		<div class="header-grid">
			<div class="title-block">
				<h1>{constants.about.title}</h1>
				<p class="intro">{constants.about.intro}</p>
			</div>

			<aside class="summary-panel">
				<p class="panel-label">{constants.about.summaryTitle}</p>
				<ul>
					{summaryItems.map((item) => (
						<li>
							<strong>{item.label}</strong>
							<span>{item.value}</span>
						</li>
					))}
				</ul>
			</aside>
		</div>
	</div>

	<div class="mission-grid">
		{mission.map((item) => (
			<article class="info-card">
				<span class="card-label">{item.label}</span>
				<p>{item.text}</p>
			</article>
		))}
	</div>

	<section class="leadership-block">
		<div class="section-heading">
			<p class="section-kicker">{constants.about.peopleTitle}</p>
			<h2>{constants.about.peopleTitle}</h2>
		</div>

		<div class="leader-grid">
			{leaders.map((person, index) => (
				<article class:list={['leader-card', { featured: index === 0 }]}>
					<div class="leader-topline">
						<span class="index">0{index + 1}</span>
						<span class="badge">{person.role}</span>
					</div>
					<h3>{person.name}</h3>
					<p>{person.bio}</p>
					{person.email ? <a class="email" href={`mailto:${person.email}`}>{person.email}</a> : null}
				</article>
			))}
		</div>
	</section>

	<section class="core-block">
		<div class="section-heading core-heading">
			<p class="section-kicker">{constants.about.coreTitle}</p>
			<h2>{constants.about.coreTitle}</h2>
		</div>
		<div class="core-grid">
			{core.map((person) => (
				<article class="core-card">
					<span class="badge">{person.role}</span>
					<h3 class="core-card-title">{person.name}</h3>
					<p>{person.bio}</p>
				</article>
			))}
		</div>
	</section>
</section>

<style>
	.about {
		padding-top: var(--space-8);
	}

	.page-header {
		padding: var(--space-2) 0 var(--space-1);
	}

	.header-topline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		margin-bottom: var(--space-4);
	}

	.eyebrow,
	.section-kicker,
	.panel-label {
		margin: 0;
		color: var(--teal);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-weight: 800;
	}

	.status-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.38rem 0.72rem;
		border: 1px solid rgba(74, 155, 149, 0.2);
		border-radius: 999px;
		background: rgba(74, 155, 149, 0.1);
		color: var(--ink);
		font-size: 0.72rem;
		font-weight: 700;
	}

	.status-pill::before {
		content: "";
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: linear-gradient(135deg, var(--teal), #8adbd3);
		box-shadow: 0 0 0 4px rgba(74, 155, 149, 0.12);
	}

	.header-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(220px, 0.75fr);
		gap: var(--space-5);
		align-items: stretch;
	}

	.title-block {
		padding: var(--space-4) 0 0;
	}

	h1 {
		margin: 0 0 0.8rem;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(3rem, 5vw, 5rem);
		line-height: 0.94;
		letter-spacing: -0.05em;
		color: var(--primary-strong);
	}

	.intro {
		margin: 0;
		max-width: 42rem;
		font-size: 1.08rem;
		line-height: 1.9;
		color: var(--ink-soft);
	}

	.summary-panel {
		padding: 1.1rem 1.15rem 0.9rem;
		border: 1px solid rgba(138, 155, 179, 0.1);
		border-radius: 1.2rem;
		background: linear-gradient(180deg, rgba(50, 62, 82, 0.98), rgba(61, 74, 94, 0.96));
		box-shadow: var(--shadow-card);
	}

	.summary-panel ul {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
		display: grid;
		gap: 0.72rem;
	}

	.summary-panel li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.85rem;
		padding: 0.72rem 0.8rem;
		border-radius: 0.9rem;
		background: rgba(40, 52, 70, 0.6);
		border: 1px solid rgba(138, 155, 179, 0.12);
		font-size: 0.92rem;
		color: var(--ink);
	}

	.summary-panel strong {
		color: var(--primary-strong);
		font-weight: 800;
	}

	.summary-panel span {
		color: var(--ink-soft);
	}

	.mission-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-4);
		margin: var(--space-8) 0;
	}

	.info-card {
		padding: var(--space-5) var(--space-4) var(--space-4);
		border: 1px solid rgba(138, 155, 179, 0.1);
		border-radius: 1.1rem;
		background: linear-gradient(180deg, rgba(50, 62, 82, 0.98), rgba(61, 74, 94, 0.96));
		box-shadow: var(--shadow-card);
	}

	.card-label {
		display: inline-block;
		margin-bottom: 0.55rem;
		color: var(--teal);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		font-weight: 800;
	}

	.info-card p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.leadership-block,
	.core-block {
		margin-top: var(--space-10);
		margin-bottom: var(--space-8);
	}

	.section-heading {
		margin-bottom: var(--space-4);
	}

	h2 {
		margin: 0.2rem 0 0;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(2.2rem, 3vw, 3rem);
		color: var(--primary-strong);
		line-height: 1.06;
	}

	.leader-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-5);
	}

	.leader-card {
		padding: var(--space-5) var(--space-5) var(--space-5);
		border: 1px solid rgba(138, 155, 179, 0.12);
		border-radius: 1.2rem;
		background: linear-gradient(180deg, rgba(50, 62, 82, 0.98), rgba(61, 74, 94, 0.96));
		box-shadow: var(--shadow-card);
	}

	.featured {
		border-color: rgba(184, 134, 11, 0.18);
		background: linear-gradient(135deg, rgba(61, 74, 94, 0.98), rgba(50, 62, 82, 0.98));
	}

	.leader-topline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		margin-bottom: 0.75rem;
	}

	.index {
		display: inline-flex;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		color: var(--teal);
	}

	.badge {
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.7rem;
		border-radius: 999px;
		background: rgba(184, 134, 11, 0.12);
		color: var(--accent-strong);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 800;
	}

	.leader-card h3 {
		margin: 0;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(1.8rem, 2.6vw, 2.5rem);
		line-height: 1.03;
		color: var(--primary-strong);
	}

	.leader-card p {
		margin: 0.8rem 0 0;
		font-size: 0.99rem;
		line-height: 1.8;
		color: var(--ink-soft);
	}

	.email {
		display: inline-flex;
		margin-top: 0.9rem;
		color: var(--teal);
		text-decoration: none;
		font-weight: 700;
		direction: ltr;
		unicode-bidi: isolate;
	}

	.core-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.9rem;
		margin-top: 1rem;
	}

	.core-card {
		padding: 0.9rem 1rem;
		border: 1px solid rgba(138, 155, 179, 0.1);
		border-radius: 0.95rem;
		background: linear-gradient(180deg, rgba(50, 62, 82, 0.98), rgba(61, 74, 94, 0.96));
		box-shadow: var(--shadow-card);
	}

	.core-card .badge {
		font-size: 0.76rem;
		padding: 0.42rem 0.8rem;
	}

	.core-card-title,
	.core-card h3 {
		margin: 0.7rem 0 0;
		font-size: 1.35rem;
		color: var(--primary-strong);
	}

	@media (max-width: 840px) {
		.header-grid,
		.mission-grid,
		.leader-grid,
		.core-grid {
			grid-template-columns: 1fr;
		}

		.header-topline,
		.leader-topline {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
