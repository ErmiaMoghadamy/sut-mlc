---
import constants from "../constants.json";
import AmuritBar from "../components/AmuritBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
}

const { title, description = constants.hero.subtitle } = Astro.props;
const pageTitle = title
    ? `${title} · ${constants.siteName}`
    : constants.siteName;
---

<!doctype html>
<html lang={constants.lang} dir={constants.dir}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap"
            rel="stylesheet"
        />
        <title>{pageTitle}</title>
    </head>
    <body>
        <!-- <AmuritBar /> -->
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style is:global>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    :root {
        --page-max: 76rem;
        --page-pad: 1.5rem;
        --navy-950: #071428;
        --navy-900: #0d2138;
        --navy-700: #163457;
        --teal-600: #1c8d87;
        --teal-500: #2ea59b;
        --gold-500: #d0a74a;
        --gold-400: #e6ca7a;
        --paper-100: #f8f4ed;
        --paper-200: #f3ebdf;
        --stone-900: #1a1f2c;
        --stone-700: #44536d;
        --stone-500: #6b7a8d;
        --line: rgba(11, 39, 72, 0.09);
    }

    html {
        font-family: "Source Sans 3", system-ui, sans-serif;
        background: var(--paper-100);
        color: var(--stone-900);
        scroll-behavior: smooth;
    }

    body {
        position: relative;
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background:
            radial-gradient(circle at top, rgba(44, 148, 138, 0.18), transparent 26%),
            radial-gradient(circle at bottom left, rgba(208, 167, 74, 0.12), transparent 28%),
            linear-gradient(180deg, #faf6ef 0%, #f3ebdf 100%);
        color: var(--stone-900);
    }

    body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image: url('/patterns/girih.svg');
        background-size: 170px 170px;
        opacity: 0.06;
        mix-blend-mode: multiply;
    }

    main {
        position: relative;
        flex: 1;
        width: 100%;
        max-width: var(--page-max);
        margin: 0 auto;
        padding: 1.25rem var(--page-pad) 4rem;
    }

    article {
        padding-top: 1rem;
        max-width: 46rem;
    }

    article :where(p, ul, ol) {
        line-height: 1.8;
        color: #2d3743;
    }

    article a {
        color: #114b8a;
    }

    article h1,
    article h2,
    article h3 {
        font-family: "Cormorant Garamond", Georgia, serif;
        color: var(--navy-900);
        letter-spacing: -0.02em;
    }

    article h1 {
        font-weight: 700;
    }

    ::selection {
        background: rgba(28, 141, 135, 0.18);
    }
</style>
