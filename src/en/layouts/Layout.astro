---
import constants from "../constants.json";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
}

const { title, description = constants.hero.subtitle } = Astro.props;
const pageTitle = title
    ? `${title} · ${constants.siteName}`
    : constants.siteName;
---

<!doctype html>
<html lang={constants.lang} dir={constants.dir}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link href="/fonts/en.css" rel="stylesheet" />
        <title>{pageTitle}</title>
    </head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style is:global>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    :root {
        --page-max: 76rem;
        --page-pad: 1.5rem;
        --navy-950: #071428;
        --navy-900: #0d2138;
        --navy-800: #122b45;
        --navy-700: #163457;
        --teal-700: #0f6d68;
        --teal-600: #1c8d87;
        --teal-500: #2ea59b;
        --gold-600: #9a7422;
        --gold-500: #d0a74a;
        --gold-400: #e6ca7a;
        --paper-100: #f5f1ea;
        --paper-200: #ece6dc;
        --paper-300: #e3ddd2;
        --stone-900: #162330;
        --stone-700: #44536d;
        --stone-500: #6b7a8d;
        --line: rgba(15, 33, 56, 0.1);
        --card: rgba(255, 255, 255, 0.7);
        --shadow-soft: 0 20px 45px rgba(11, 25, 40, 0.08);
    }

    html {
        font-family: "Source Sans 3", system-ui, sans-serif;
        background: var(--paper-100);
        color: var(--stone-900);
        scroll-behavior: smooth;
    }

    body {
        position: relative;
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background:
            radial-gradient(circle at 12% 0%, rgba(28, 141, 135, 0.14), transparent 20%),
            radial-gradient(circle at 90% 10%, rgba(208, 167, 74, 0.14), transparent 22%),
            linear-gradient(180deg, #f8f4ee 0%, #f0efe9 100%);
        color: var(--stone-900);
    }

    body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image: url('/patterns/girih.svg');
        background-size: 150px 150px;
        opacity: 0.05;
        mix-blend-mode: multiply;
    }

    main {
        position: relative;
        flex: 1;
        width: min(100%, calc(var(--page-max) + 2rem));
        margin: 0 auto;
        padding: 1.5rem var(--page-pad) 4rem;
    }

    article {
        padding-top: 1rem;
        max-width: 46rem;
    }

    article :where(p, ul, ol) {
        line-height: 1.8;
        color: #2d3743;
    }

    article a {
        color: #114b8a;
    }

    article h1,
    article h2,
    article h3 {
        font-family: "Cormorant Garamond", Georgia, serif;
        color: var(--navy-900);
        letter-spacing: -0.02em;
    }

    article h1 {
        font-weight: 700;
    }

    a {
        transition: opacity 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
    }

    ::selection {
        background: rgba(28, 141, 135, 0.16);
    }
</style>
