---
import { getCollection, render } from 'astro:content';
import Layout from '../../en/layouts/Layout.astro';
import constants from '../../en/constants.json';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readTime = Math.max(2, Math.ceil((post.body || '').trim().split(/\s+/).filter(Boolean).length / 220));
---

<Layout title={post.data.title} description={post.data.description}>
	<article class="post-page">
		<div class="masthead">
			<a class="back-link" href="/posts">← All posts</a>
			<div class="meta-row">
				<span class="kind">{constants.kinds[post.data.kind]}</span>
				<time datetime={post.data.pubDate.toISOString()}>
					{post.data.pubDate.toLocaleDateString('en-US', {
						year: 'numeric',
						month: 'long',
						day: 'numeric',
					})}
				</time>
			</div>
			<h1>{post.data.title}</h1>
			<p class="dek">{post.data.description}</p>
			<div class="read-meta">
				<span class="meta-badge">{readTime} min read</span>
				<span class="meta-badge">Editorial note</span>
			</div>
		</div>

		<div class="post-body">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.post-page {
		max-width: 68rem;
		padding-top: 2.6rem;
	}

	.masthead {
		padding: 2rem 2.5rem;
		border: 1px solid rgba(138, 155, 179, 0.15);
		border-radius: 1.5rem;
		background: linear-gradient(135deg, rgba(50, 62, 82, 0.98), rgba(61, 74, 94, 0.96));
		box-shadow: var(--shadow-card);
		position: relative;
		overflow: hidden;
	}

	.masthead::before {
		content: "";
		position: absolute;
		top: -50%;
		right: -20%;
		width: 60%;
		height: 200%;
		background: radial-gradient(ellipse, rgba(74, 155, 149, 0.06) 0%, transparent 60%);
		pointer-events: none;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		margin-bottom: 1rem;
		color: var(--teal);
		font-weight: 700;
		text-decoration: none;
		transition: color 0.2s ease;
		position: relative;
		z-index: 1;
	}

	.back-link:hover {
		color: var(--accent-strong);
	}

	.meta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.8rem;
		margin-bottom: 1rem;
		position: relative;
		z-index: 1;
	}

	.kind {
		padding: 0.35rem 0.7rem;
		border-radius: 999px;
		background: rgba(74, 155, 149, 0.15);
		border: 1px solid rgba(74, 155, 149, 0.25);
		color: var(--teal);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	time {
		color: var(--muted);
		font-size: 0.85rem;
	}

	h1 {
		margin: 0 0 1rem;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(3rem, 5vw, 4.5rem);
		line-height: 1.04;
		letter-spacing: -0.03em;
		color: var(--primary-strong);
		position: relative;
		z-index: 1;
	}

	.dek {
		margin: 0;
		max-width: 45rem;
		font-size: 1.15rem;
		line-height: 1.75;
		color: var(--ink);
		position: relative;
		z-index: 1;
	}

	.read-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
		position: relative;
		z-index: 1;
	}

	.meta-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 0.9rem;
		border-radius: 999px;
		background: rgba(40, 52, 70, 0.6);
		border: 1px solid rgba(138, 155, 179, 0.2);
		color: var(--ink-soft);
		font-size: 0.8rem;
		font-weight: 600;
	}

	.post-body {
		margin-top: 2rem;
		padding: 2.5rem;
		background: linear-gradient(135deg, rgba(50, 62, 82, 0.98), rgba(61, 74, 94, 0.96));
		border: 1px solid rgba(138, 155, 179, 0.15);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-card);
	}

	.post-body :global(p),
	.post-body :global(ul),
	.post-body :global(ol),
	.post-body :global(li),
	.post-body :global(blockquote) {
		color: var(--ink);
	}

	.post-body :global(p) {
		margin: 0 0 1.5rem;
		font-size: 1.1rem;
		line-height: 1.9;
	}

	.post-body :global(h2),
	.post-body :global(h3) {
		margin: 2.5rem 0 1rem;
		color: var(--primary-strong);
		line-height: 1.25;
	}

	.post-body :global(h2) {
		font-size: clamp(1.9rem, 2.5vw, 2.4rem);
		font-family: "Cormorant Garamond", Georgia, serif;
	}

	.post-body :global(h3) {
		font-size: 1.4rem;
	}

	.post-body :global(ul),
	.post-body :global(ol) {
		padding-inline-start: 1.5rem;
		margin: 0 0 1.5rem;
		line-height: 1.9;
	}

	.post-body :global(li) + :global(li) {
		margin-top: 0.5rem;
	}

	.post-body :global(blockquote) {
		margin: 2rem 0;
		padding: 1rem 1.5rem;
		border-inline-start: 4px solid var(--teal);
		background: rgba(74, 155, 149, 0.08);
		border-radius: 0 1rem 1rem 0;
		font-style: italic;
		color: var(--ink-soft);
	}

	.post-body :global(a) {
		color: var(--teal);
		text-decoration: underline;
		text-decoration-color: rgba(74, 155, 149, 0.3);
		transition: all 0.2s ease;
	}

	.post-body :global(a:hover) {
		color: var(--accent-strong);
		text-decoration-color: var(--accent-strong);
	}

	.post-body :global(code) {
		padding: 0.2rem 0.5rem;
		border-radius: 0.4rem;
		background: rgba(40, 52, 70, 0.8);
		border: 1px solid rgba(138, 155, 179, 0.2);
		color: var(--teal);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.95rem;
	}

	.post-body :global(pre) {
		margin: 1.5rem 0;
		padding: 1.5rem;
		background: rgba(30, 36, 48, 0.9);
		border: 1px solid rgba(138, 155, 179, 0.2);
		border-radius: 1rem;
		overflow-x: auto;
	}

	.post-body :global(pre code) {
		background: transparent;
		border: none;
		padding: 0;
		color: var(--ink);
	}

	@media (max-width: 720px) {
		.post-page {
			padding-top: 2rem;
		}

		.masthead,
		.post-body {
			padding-inline: 1.5rem;
		}

		h1 {
			font-size: clamp(2.5rem, 8vw, 3.5rem);
		}
	}
</style>