---
import { getCollection, render } from 'astro:content';
import Layout from '../../../fa/layouts/Layout.astro';
import constants from '../../../fa/constants.json';

export async function getStaticPaths() {
	const posts = await getCollection('blogFa');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const readTime = Math.max(2, Math.ceil((post.body || '').trim().split(/\s+/).filter(Boolean).length / 220));
---

<Layout title={post.data.title} description={post.data.description}>
	<article class="post-page">
		<div class="masthead">
			<a class="back-link" href="/fa/posts">← همهٔ نوشته‌ها</a>
			<div class="meta-row">
				<span class="kind">{constants.kinds[post.data.kind]}</span>
				<time datetime={post.data.pubDate.toISOString()}>
					{post.data.pubDate.toLocaleDateString('fa-IR')}
				</time>
			</div>
			<h1>{post.data.title}</h1>
			<p class="dek">{post.data.description}</p>
			<div class="read-meta">
				<span>{readTime} دقیقه مطالعه</span>
				<span>یادداشت تحریریه</span>
			</div>
		</div>

		<div class="post-body">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.post-page {
		max-width: 62rem;
		padding-top: 2.6rem;
	}

	.masthead {
		padding: 1.3rem 1.4rem 1rem;
		border: 1px solid rgba(11, 39, 72, 0.08);
		border-radius: 1.3rem;
		background: linear-gradient(180deg, rgba(255, 253, 249, 0.96), rgba(244, 228, 166, 0.15));
		box-shadow: 0 18px 32px rgba(15, 30, 48, 0.06);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		margin-bottom: 0.85rem;
		color: #1d9a8c;
		font-weight: 700;
		text-decoration: none;
	}

	.meta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.8rem;
		margin-bottom: 0.65rem;
		color: #1d9a8c;
		font-size: 0.8rem;
	}

	.kind {
		font-weight: 700;
		color: #c9a227;
	}

	time {
		color: #1d9a8c;
	}

	h1 {
		margin: 0 0 0.7rem;
		font-size: clamp(2.2rem, 5vw, 3.5rem);
		line-height: 1.3;
		color: #0b2748;
	}

	.dek {
		margin: 0;
		max-width: 42rem;
		font-size: 1.08rem;
		line-height: 2;
		color: #3d5470;
	}

	.read-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-top: 1rem;
	}

	.read-meta span {
		display: inline-flex;
		align-items: center;
		padding: 0.42rem 0.7rem;
		border-radius: 999px;
		background: rgba(11, 39, 72, 0.04);
		border: 1px solid rgba(11, 39, 72, 0.08);
		color: #0b2748;
		font-size: 0.8rem;
		font-weight: 600;
	}

	.post-body {
		margin-top: 1.25rem;
		padding: 1.4rem 1.4rem 1.2rem;
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid rgba(11, 39, 72, 0.08);
		border-radius: 1.2rem;
		box-shadow: 0 10px 24px rgba(11, 39, 72, 0.04);
	}

	.post-body :global(p),
	.post-body :global(ul),
	.post-body :global(ol),
	.post-body :global(li),
	.post-body :global(blockquote) {
		color: #2a3b54;
	}

	.post-body :global(p) {
		margin: 0 0 1.1rem;
		font-size: 1.04rem;
		line-height: 2;
	}

	.post-body :global(h2),
	.post-body :global(h3) {
		margin: 2rem 0 0.8rem;
		color: #0b2748;
		line-height: 1.5;
	}

	.post-body :global(h2) {
		font-size: clamp(1.5rem, 2.3vw, 1.9rem);
	}

	.post-body :global(h3) {
		font-size: 1.2rem;
	}

	.post-body :global(ul),
	.post-body :global(ol) {
		padding-inline-start: 1.35rem;
		margin: 0 0 1.2rem;
		line-height: 2;
	}

	.post-body :global(li) + :global(li) {
		margin-top: 0.4rem;
	}

	.post-body :global(blockquote) {
		margin: 1.4rem 0;
		padding: 0.8rem 1rem 0.8rem 1.2rem;
		border-inline-start: 4px solid #1d9a8c;
		background: rgba(29, 154, 140, 0.04);
		border-radius: 0 0.7rem 0.7rem 0;
		font-style: italic;
	}

	.post-body :global(a) {
		color: #1d4f8d;
	}

	.post-body :global(code) {
		padding: 0.15rem 0.35rem;
		border-radius: 0.35rem;
		background: rgba(11, 39, 72, 0.06);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}

	@media (max-width: 720px) {
		.post-page {
			padding-top: 2rem;
		}

		.masthead,
		.post-body {
			padding-inline: 1rem;
		}
	}
</style>
