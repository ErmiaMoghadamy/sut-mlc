---
import { getCollection, render } from 'astro:content';
import Layout from '../../../fa/layouts/Layout.astro';
import constants from '../../../fa/constants.json';

export async function getStaticPaths() {
	const posts = await getCollection('blogFa');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
	<article>
		<p class="date">
			<em>{constants.kinds[post.data.kind]}</em>
			<time datetime={post.data.pubDate.toISOString()}>
				{post.data.pubDate.toLocaleDateString('fa-IR')}
			</time>
		</p>
		<h1>{post.data.title}</h1>
		<Content />
	</article>
</Layout>

<style>
	.date {
		display: flex;
		gap: 0.8rem;
		margin: 0 0 0.55rem;
		color: #1d9a8c;
		font-size: 0.92rem;
	}

	em {
		font-style: normal;
		color: #c9a227;
	}

	h1 {
		margin: 0 0 1.35rem;
		font-size: clamp(1.7rem, 5vw, 2.4rem);
		line-height: 1.45;
	}
</style>
