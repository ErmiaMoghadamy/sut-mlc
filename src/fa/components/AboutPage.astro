---
import constants from '../constants.json';

const { leaders, core, mission, summaryItems } = constants.about;
---

<section class="about">
	<div class="page-header">
		<div class="header-topline">
			<span class="eyebrow">{constants.about.title}</span>
			<span class="status-pill">{constants.about.status}</span>
		</div>

		<div class="header-grid">
			<div class="title-block">
				<h1>{constants.about.title}</h1>
				<p class="intro">{constants.about.intro}</p>
			</div>

			<aside class="summary-panel">
				<p class="panel-label">{constants.about.summaryTitle}</p>
				<ul>
					{summaryItems.map((item) => (
						<li>
							<strong>{item.label}</strong>
							<span>{item.value}</span>
						</li>
					))}
				</ul>
			</aside>
		</div>
	</div>

	<div class="mission-grid">
		{mission.map((item) => (
			<article class="info-card">
				<span class="card-label">{item.label}</span>
				<p>{item.text}</p>
			</article>
		))}
	</div>

	<section class="leadership-block">
		<div class="section-heading">
			<p class="section-kicker">{constants.about.peopleTitle}</p>
			<h2>{constants.about.peopleTitle}</h2>
		</div>

		<div class="leader-grid">
			{leaders.map((person, index) => (
				<article class:list={['leader-card', { featured: index === 0 }]}>
					<div class="leader-topline">
						<span class="index">0{index + 1}</span>
						<span class="badge">{person.role}</span>
					</div>
					<h3>{person.name}</h3>
					<p>{person.bio}</p>
					{person.email ? <a class="email" href={`mailto:${person.email}`}>{person.email}</a> : null}
				</article>
			))}
		</div>
	</section>

	<section class="core-block">
		<div class="section-heading core-heading">
			<p class="section-kicker">{constants.about.coreTitle}</p>
			<h2>{constants.about.coreTitle}</h2>
		</div>
		<div class="core-grid">
			{core.map((person) => (
				<article class="core-card">
					<span class="badge">{person.role}</span>
					<h3>{person.name}</h3>
				</article>
			))}
		</div>
	</section>
</section>

<style>
	.about {
		padding-top: 2.4rem;
	}

	.page-header {
		padding: 0.5rem 0 0.25rem;
	}

	.header-topline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.eyebrow,
	.section-kicker,
	.panel-label {
		margin: 0;
		color: #1a7d77;
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		font-weight: 800;
	}

	.status-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.38rem 0.72rem;
		border: 1px solid rgba(26, 125, 119, 0.2);
		border-radius: 999px;
		background: rgba(26, 125, 119, 0.08);
		color: #153a4b;
		font-size: 0.72rem;
		font-weight: 700;
	}

	.status-pill::before {
		content: "";
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: linear-gradient(135deg, #1d9b8a, #9ad9cf);
		box-shadow: 0 0 0 4px rgba(29, 155, 138, 0.12);
	}

	.header-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(220px, 0.75fr);
		gap: 1.2rem;
		align-items: stretch;
	}

	.title-block {
		padding: 0.9rem 0 0;
	}

	h1 {
		margin: 0 0 0.8rem;
		font-size: clamp(2.9rem, 5vw, 5rem);
		line-height: 1.0;
		letter-spacing: -0.05em;
		color: #0e233b;
	}

	.intro {
		margin: 0;
		max-width: 42rem;
		font-size: 1.08rem;
		line-height: 1.9;
		color: #3f536d;
	}

	.summary-panel {
		padding: 1.1rem 1.15rem 0.9rem;
		border: 1px solid rgba(14, 35, 59, 0.08);
		border-radius: 1.2rem;
		background: linear-gradient(180deg, rgba(255,255,255,0.88), rgba(241,246,247,0.92));
		box-shadow: 0 18px 35px rgba(10, 25, 43, 0.05);
	}

	.summary-panel ul {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
		display: grid;
		gap: 0.72rem;
	}

	.summary-panel li {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.85rem;
		padding: 0.72rem 0.8rem;
		border-radius: 0.9rem;
		background: rgba(14, 35, 59, 0.03);
		border: 1px solid rgba(14, 35, 59, 0.06);
		font-size: 0.92rem;
		color: #1d2f46;
	}

	.summary-panel strong {
		color: #0e233b;
		font-weight: 800;
	}

	.summary-panel span {
		color: #4f647d;
	}

	.mission-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin: 1.5rem 0 2.3rem;
	}

	.info-card {
		padding: 1.15rem 1.1rem 1.05rem;
		border: 1px solid rgba(14, 35, 59, 0.08);
		border-radius: 1.1rem;
		background: rgba(255,255,255,0.7);
		box-shadow: 0 10px 22px rgba(15, 30, 48, 0.04);
	}

	.card-label {
		display: inline-block;
		margin-bottom: 0.55rem;
		color: #1b8b84;
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		font-weight: 800;
	}

	.info-card p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.75;
		color: #3c536d;
	}

	.leadership-block,
	.core-block {
		margin-top: 0.2rem;
	}

	.section-heading {
		margin-bottom: 1rem;
	}

	h2 {
		margin: 0.2rem 0 0;
		font-size: clamp(2.2rem, 3vw, 3rem);
		color: #0e233b;
		line-height: 1.06;
	}

	.leader-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.15rem;
	}

	.leader-card {
		padding: 1.2rem 1.15rem 1.15rem;
		border: 1px solid rgba(14, 35, 59, 0.1);
		border-radius: 1.2rem;
		background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(242,246,247,0.94));
		box-shadow: 0 18px 32px rgba(7, 20, 40, 0.05);
	}

	.featured {
		border-color: rgba(14, 35, 59, 0.15);
		background: linear-gradient(135deg, rgba(255,255,255,0.98), rgba(236,243,245,0.98));
	}

	.leader-topline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		margin-bottom: 0.75rem;
	}

	.index {
		display: inline-flex;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		color: #1a7d77;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.7rem;
		border-radius: 999px;
		background: rgba(208, 167, 74, 0.14);
		color: #775f14;
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 800;
	}

	.leader-card h3 {
		margin: 0;
		font-size: clamp(2rem, 3vw, 2.9rem);
		line-height: 1.03;
		color: #0e233b;
	}

	.leader-card p {
		margin: 0.8rem 0 0;
		font-size: 0.99rem;
		line-height: 1.8;
		color: #435d7a;
	}

	.email {
		display: inline-flex;
		margin-top: 0.9rem;
		color: #126d68;
		text-decoration: none;
		font-weight: 700;
		direction: ltr;
		unicode-bidi: isolate;
	}

	.core-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.9rem;
		margin-top: 1rem;
	}

	.core-card {
		padding: 0.9rem 1rem;
		border: 1px solid rgba(14, 35, 59, 0.08);
		border-radius: 0.95rem;
		background: rgba(255,255,255,0.72);
		box-shadow: 0 10px 22px rgba(15, 30, 48, 0.03);
	}

	.core-card h3 {
		margin: 0.7rem 0 0;
		font-size: 1rem;
		color: #0e233b;
	}

	@media (max-width: 840px) {
		.header-grid,
		.mission-grid,
		.leader-grid,
		.core-grid {
			grid-template-columns: 1fr;
		}

		.header-topline,
		.leader-topline {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
