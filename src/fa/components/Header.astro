---
import constants from '../constants.json';

const path = Astro.url.pathname.replace(/\/$/, '') || '/fa';
---

<header>
	<div class="khatam" aria-hidden="true"></div>
	<div class="filigree" aria-hidden="true"></div>
	<div class="bar">
		<div class="inner">
			<a class="brand" href={constants.homeHref}>
				<span class="shamse">
					<svg class="emblem" viewBox="0 0 64 64" aria-hidden="true">
						<g fill="#e8d48b">
							<rect x="18" y="18" width="28" height="28"></rect>
							<rect x="18" y="18" width="28" height="28" transform="rotate(45 32 32)"></rect>
						</g>
						<g fill="#071428">
							<rect x="23" y="23" width="18" height="18"></rect>
							<rect x="23" y="23" width="18" height="18" transform="rotate(45 32 32)"></rect>
						</g>
						<circle cx="32" cy="32" r="6" fill="#1d9a8c"></circle>
						<circle cx="32" cy="32" r="2.4" fill="#f4e4a6"></circle>
					</svg>
				</span>
				<span class="names">
					<span class="name">{constants.siteName}</span>
					<span class="mark">{constants.siteMark}</span>
				</span>
			</a>

			<nav class="links" aria-label="اصلی">
				{constants.nav.links.map((link) => (
					<a href={link.href} class:list={[{ current: path === link.href || path.startsWith(`${link.href}/`) }]}>
						{link.label}
					</a>
				))}
				<a class="lang" href={constants.nav.otherLangHref} lang="en" dir="ltr">
					{constants.nav.otherLang}
				</a>
			</nav>

			<button class="burger" type="button" aria-expanded="false" aria-controls="site-menu">
				<span class="bars" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
				<span class="label">{constants.nav.menu}</span>
			</button>
		</div>
	</div>
	<div class="filigree" aria-hidden="true"></div>
	<div class="khatam" aria-hidden="true"></div>
</header>

<div id="site-menu" class="drawer" hidden>
	<div class="drawer-panel">
		<div class="drawer-top">
			<strong>{constants.siteName}</strong>
			<button class="close" type="button">{constants.nav.close}</button>
		</div>
		<nav>
			{constants.nav.links.map((link) => (
				<a href={link.href}>{link.label}</a>
			))}
			<a class="lang" href={constants.nav.otherLangHref} lang="en" dir="ltr">
				{constants.nav.otherLang}
			</a>
		</nav>
	</div>
</div>

<script>
	const burger = document.querySelector('.burger');
	const drawer = document.querySelector('#site-menu');
	const closeBtn = document.querySelector('.close');

	function openMenu() {
		if (!(burger instanceof HTMLButtonElement) || !(drawer instanceof HTMLElement)) return;
		drawer.hidden = false;
		burger.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
	}

	function closeMenu() {
		if (!(burger instanceof HTMLButtonElement) || !(drawer instanceof HTMLElement)) return;
		drawer.hidden = true;
		burger.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	}

	burger?.addEventListener('click', () => {
		if (drawer instanceof HTMLElement && drawer.hidden) openMenu();
		else closeMenu();
	});
	closeBtn?.addEventListener('click', closeMenu);
	drawer?.addEventListener('click', (event) => {
		if (event.target === drawer) closeMenu();
	});
	window.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeMenu();
	});
</script>

<style>
	header {
		width: 100%;
		color: #f4e4a6;
		box-shadow: 0 18px 40px rgba(7, 20, 40, 0.24);
	}

	.khatam {
		height: 12px;
		background-color: #071428;
		background-image: url('/patterns/khatam-band.svg');
		background-repeat: repeat-x;
		background-size: 48px 12px;
	}

	.filigree {
		height: 3px;
		background: linear-gradient(90deg, #1d9a8c, #c9a227, #1d9a8c);
	}

	.bar {
		background-color: #071428;
		background-image:
			radial-gradient(circle at 80% 120%, rgba(29, 154, 140, 0.32), transparent 46%),
			radial-gradient(circle at 18% -30%, rgba(232, 212, 139, 0.2), transparent 40%),
			url('/patterns/girih.svg');
		background-size: auto, auto, 140px 140px;
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		width: 100%;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 1rem var(--page-pad);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		color: inherit;
		text-decoration: none;
		min-width: 0;
	}

	.shamse {
		display: grid;
		place-items: center;
		width: 3.15rem;
		height: 3.15rem;
		flex-shrink: 0;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(201, 162, 39, 0.28), transparent 70%);
		box-shadow: 0 0 0 1px rgba(201, 162, 39, 0.35);
	}

	.emblem {
		width: 2.55rem;
		height: 2.55rem;
	}

	.names {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
	}

	.name {
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.35;
		unicode-bidi: isolate;
	}

	.mark {
		color: #7fd4c8;
		font-size: 0.82rem;
	}

	.links {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-shrink: 0;
	}

	.links a,
	.drawer nav a {
		text-decoration: none;
		font-size: 0.95rem;
		padding: 0.42rem 0.95rem;
		border-radius: 999px;
		border: 1px solid transparent;
		color: #f4e4a6;
	}

	.links a:hover,
	.links a.current {
		background: rgba(201, 162, 39, 0.16);
		border-color: #e8d48b;
	}

	.lang {
		border-color: rgba(29, 154, 140, 0.55) !important;
		color: #9ee7dc !important;
	}

	.burger {
		display: none;
		align-items: center;
		gap: 0.55rem;
		background: rgba(201, 162, 39, 0.12);
		color: #f4e4a6;
		border: 1px solid rgba(201, 162, 39, 0.4);
		border-radius: 999px;
		padding: 0.45rem 0.85rem;
		cursor: pointer;
		font: inherit;
	}

	.bars {
		display: grid;
		gap: 3px;
	}

	.bars span {
		display: block;
		width: 1.05rem;
		height: 2px;
		background: #f4e4a6;
	}

	.drawer {
		position: fixed;
		inset: 0;
		z-index: 40;
		background: rgba(7, 20, 40, 0.55);
		display: grid;
		justify-items: start;
	}

	.drawer[hidden] {
		display: none;
	}

	.drawer-panel {
		width: min(22rem, 100%);
		height: 100%;
		background: #071428;
		color: #f4e4a6;
		padding: 1.25rem 1.35rem 2rem;
		box-shadow: 18px 0 40px rgba(7, 20, 40, 0.28);
	}

	.drawer-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.4rem;
	}

	.close {
		background: transparent;
		border: 1px solid rgba(201, 162, 39, 0.4);
		color: inherit;
		border-radius: 999px;
		padding: 0.35rem 0.8rem;
		cursor: pointer;
		font: inherit;
	}

	.drawer nav {
		display: grid;
		gap: 0.55rem;
	}

	.drawer nav a {
		display: block;
		font-size: 1.15rem;
		padding: 0.7rem 0.85rem;
		border: 1px solid rgba(201, 162, 39, 0.22);
	}

	@media (max-width: 840px) {
		.links {
			display: none;
		}

		.burger {
			display: inline-flex;
		}
	}
</style>
