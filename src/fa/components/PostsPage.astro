---
import { getCollection } from 'astro:content';
import constants from '../constants.json';

const posts = (await getCollection('blogFa')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const articles = posts.filter((post) => post.data.kind === 'article');
const shorts = posts.filter((post) => post.data.kind === 'short');
---

<section class="page">
	<div class="page-header">
		<div>
			<h1>{constants.postsPage.title}</h1>
			<p class="intro">{constants.postsPage.intro}</p>
		</div>
		<div class="summary-badges" aria-label="خلاصهٔ محتوا">
			<span>{articles.length} مقاله</span>
			<span>{shorts.length} یادداشت کوتاه</span>
		</div>
	</div>

	<section class="section-block" aria-labelledby="articles-heading">
		<div class="section-header">
			<h2 id="articles-heading">{constants.postsPage.articles}</h2>
		</div>
		{articles.length === 0 ? (
			<p class="empty">{constants.postsPage.empty}</p>
		) : (
			<ul class="articles">
				{articles.map((post, index) => (
					<li class:list={['article-item', `article-tone-${(index % 3) + 1}`]}>
						<a href={`/fa/posts/${post.id}`}>
							<div class="meta-row">
								<em>{constants.kinds.article}</em>
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('fa-IR')}
								</time>
							</div>
							<strong>{post.data.title}</strong>
							<span>{post.data.description}</span>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>

	<section class="section-block" aria-labelledby="shorts-heading">
		<div class="section-header">
			<h2 id="shorts-heading">{constants.postsPage.shorts}</h2>
		</div>
		{shorts.length === 0 ? (
			<p class="empty">{constants.postsPage.empty}</p>
		) : (
			<ul class="shorts">
				{shorts.map((post, index) => (
					<li class:list={['short-item', `short-tone-${(index % 2) + 1}`]}>
						<a href={`/fa/posts/${post.id}`}>
							<em>{constants.kinds.short}</em>
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('fa-IR')}
							</time>
							<strong>{post.data.title}</strong>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>
</section>

<style>
	.page {
		padding-top: 2.4rem;
	}

	.page-header {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1rem;
		margin-bottom: 1.8rem;
		padding: 1.4rem 1.5rem;
		border: 1px solid rgba(138, 155, 179, 0.1);
		border-radius: 1.5rem;
		background: linear-gradient(135deg, rgba(37, 46, 63, 0.96), rgba(45, 56, 74, 0.94));
		box-shadow: var(--shadow-card);
	}

	h1 {
		margin: 0 0 0.7rem;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(2.6rem, 4vw, 4rem);
		line-height: 1.02;
		color: var(--primary-strong);
	}

	.intro {
		margin: 0;
		max-width: 40rem;
		color: var(--ink-soft);
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.summary-badges {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.55rem;
	}

	.summary-badges span {
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 0.8rem;
		border-radius: 999px;
		background: var(--teal-soft);
		border: 1px solid rgba(74, 155, 149, 0.18);
		color: var(--primary);
		font-size: 0.8rem;
		font-weight: 700;
	}

	.section-block {
		margin-bottom: 2.2rem;
	}

	.section-header {
		margin-bottom: 0.8rem;
	}

	h2 {
		margin: 0;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(1.8rem, 2vw, 2.4rem);
		color: var(--primary-strong);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	a {
		display: grid;
		gap: 0.34rem;
		text-decoration: none;
		color: inherit;
		border: 1px solid rgba(138, 155, 179, 0.1);
		border-radius: 1.15rem;
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	a:hover {
		transform: translateY(-1px);
		box-shadow: 0 14px 24px rgba(26, 32, 44, 0.12);
		border-color: rgba(74, 155, 149, 0.2);
	}

	.articles {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.article-item {
		--article-bg: linear-gradient(180deg, rgba(37, 46, 63, 0.96), rgba(45, 56, 74, 0.96));
		--article-accent: var(--primary);
		--article-accent-soft: rgba(184, 134, 11, 0.15);
	}

	.article-tone-2 {
		--article-bg: linear-gradient(180deg, rgba(45, 56, 74, 0.96), rgba(37, 46, 63, 0.96));
		--article-accent: var(--teal);
		--article-accent-soft: rgba(74, 155, 149, 0.16);
	}

	.article-tone-3 {
		--article-bg: linear-gradient(180deg, rgba(45, 56, 74, 0.96), rgba(37, 46, 63, 0.96));
		--article-accent: var(--accent-strong);
		--article-accent-soft: rgba(184, 134, 11, 0.16);
	}

	.articles a {
		padding: 1.2rem 1.25rem;
		min-height: 10rem;
		background: var(--article-bg);
		border-inline-start: 4px solid var(--article-accent);
	}

	.shorts {
		display: grid;
		gap: 0.8rem;
	}

	.short-item {
		--short-bg: rgba(37, 46, 63, 0.9);
		--short-accent: var(--teal);
	}

	.short-tone-2 {
		--short-bg: rgba(45, 56, 74, 0.9);
		--short-accent: var(--accent-strong);
	}

	.shorts a {
		grid-template-columns: auto auto 1fr;
		align-items: center;
		gap: 0.8rem;
		padding: 0.9rem 1rem;
		background: var(--short-bg);
		border-inline-start: 3px solid var(--short-accent);
	}

	.meta-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.8rem;
	}

	em {
		font-style: normal;
		color: var(--article-accent, var(--short-accent));
		background: var(--article-accent-soft, rgba(74, 155, 149, 0.12));
		padding: 0.25rem 0.5rem;
		border-radius: 999px;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 700;
	}

	time {
		color: var(--muted);
		font-size: 0.8rem;
	}

	strong {
		color: var(--primary-strong);
		font-size: 1.08rem;
		line-height: 1.45;
	}

	span {
		color: var(--ink-soft);
		line-height: 1.6;
	}

	.empty {
		margin: 0;
		padding: 1rem 0;
		color: var(--muted);
	}

	@media (max-width: 840px) {
		.page-header {
			flex-direction: column;
			align-items: flex-start;
		}

		.summary-badges {
			justify-content: flex-start;
		}

		.articles {
			grid-template-columns: 1fr;
		}

		.shorts a {
			grid-template-columns: 1fr;
			gap: 0.3rem;
		}
	}
</style>
