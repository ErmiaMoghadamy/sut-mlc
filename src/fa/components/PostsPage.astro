---
import { getCollection } from 'astro:content';
import constants from '../constants.json';

const posts = (await getCollection('blogFa')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const articles = posts.filter((post) => post.data.kind === 'article');
const shorts = posts.filter((post) => post.data.kind === 'short');
---

<section class="page">
	<div class="page-header">
		<div>
			<h1>{constants.postsPage.title}</h1>
			<p class="intro">{constants.postsPage.intro}</p>
		</div>
		<div class="summary-badges" aria-label="خلاصهٔ محتوا">
			<span>{articles.length} مقاله</span>
			<span>{shorts.length} یادداشت کوتاه</span>
		</div>
	</div>

	<section class="section-block" aria-labelledby="articles-heading">
		<div class="section-header">
			<h2 id="articles-heading">{constants.postsPage.articles}</h2>
		</div>
		{articles.length === 0 ? (
			<p class="empty">{constants.postsPage.empty}</p>
		) : (
			<ul class="articles">
				{articles.map((post) => (
					<li>
						<a href={`/fa/posts/${post.id}`}>
							<div class="meta-row">
								<em>{constants.kinds.article}</em>
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('fa-IR')}
								</time>
							</div>
							<strong>{post.data.title}</strong>
							<span>{post.data.description}</span>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>

	<section class="section-block" aria-labelledby="shorts-heading">
		<div class="section-header">
			<h2 id="shorts-heading">{constants.postsPage.shorts}</h2>
		</div>
		{shorts.length === 0 ? (
			<p class="empty">{constants.postsPage.empty}</p>
		) : (
			<ul class="shorts">
				{shorts.map((post) => (
					<li>
						<a href={`/fa/posts/${post.id}`}>
							<em>{constants.kinds.short}</em>
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('fa-IR')}
							</time>
							<strong>{post.data.title}</strong>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>
</section>

<style>
	.page {
		padding-top: 2.6rem;
	}

	.page-header {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 1rem;
		margin-bottom: 1.8rem;
	}

	h1 {
		margin: 0 0 0.7rem;
		font-size: clamp(2.2rem, 4vw, 3.2rem);
		line-height: 1.3;
		color: #0b2748;
	}

	.intro {
		margin: 0;
		max-width: 40rem;
		color: #3d5470;
		font-size: 1.08rem;
		line-height: 2;
	}

	.summary-badges {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.55rem;
	}

	.summary-badges span {
		display: inline-flex;
		align-items: center;
		padding: 0.45rem 0.75rem;
		border-radius: 999px;
		background: rgba(29, 154, 140, 0.08);
		border: 1px solid rgba(29, 154, 140, 0.2);
		color: #0b2748;
		font-size: 0.8rem;
		font-weight: 700;
	}

	.section-block {
		margin-bottom: 2.2rem;
	}

	.section-header {
		margin-bottom: 0.8rem;
	}

	h2 {
		margin: 0;
		font-size: clamp(1.6rem, 2vw, 2.1rem);
		color: #0b2748;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	a {
		display: grid;
		gap: 0.32rem;
		text-decoration: none;
		color: inherit;
		background: rgba(255, 252, 246, 0.82);
		border: 1px solid rgba(18, 58, 107, 0.08);
		border-radius: 1rem;
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	a:hover {
		transform: translateY(-1px);
		box-shadow: 0 12px 24px rgba(11, 39, 72, 0.08);
		border-color: rgba(29, 154, 140, 0.25);
	}

	.articles {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.articles a {
		padding: 1.2rem 1.25rem;
		border-inline-start: 4px solid #071428;
		min-height: 9.6rem;
	}

	.shorts {
		display: grid;
		gap: 0.7rem;
	}

	.shorts a {
		grid-template-columns: auto auto 1fr;
		align-items: center;
		gap: 0.9rem;
		padding: 0.8rem 0.95rem;
		border-inline-start: 3px solid #1d9a8c;
	}

	.meta-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
	}

	em {
		font-style: normal;
		color: #c9a227;
		font-size: 0.8rem;
		font-weight: 700;
	}

	time {
		color: #1d9a8c;
		font-size: 0.85rem;
	}

	strong {
		color: #0b2748;
		font-size: 1.08rem;
		line-height: 1.7;
	}

	span {
		color: #5c6b80;
		line-height: 1.8;
	}

	.empty {
		margin: 0;
		padding: 1rem 0;
		color: #5c6b80;
	}

	@media (max-width: 840px) {
		.page-header {
			flex-direction: column;
			align-items: flex-start;
		}

		.summary-badges {
			justify-content: flex-start;
		}

		.articles {
			grid-template-columns: 1fr;
		}

		.shorts a {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
