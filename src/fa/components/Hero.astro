---
import constants from '../constants.json';
---

<section class="hero">
	<p class="kicker">{constants.hero.kicker}</p>
	<h1>{constants.hero.title}</h1>
	<span class="ornament" aria-hidden="true"></span>
	<p class="lead">{constants.hero.subtitle}</p>
	<div class="actions">
		<a class="primary" href={constants.hero.primaryCta.href}>{constants.hero.primaryCta.label}</a>
		<a class="secondary" href={constants.hero.secondaryCta.href}>{constants.hero.secondaryCta.label}</a>
	</div>
</section>

<style>
	.hero {
		padding: 3.3rem 0 2.4rem;
		text-align: start;
		max-width: 40rem;
	}

	.kicker {
		margin: 0 0 0.75rem;
		color: #1d9a8c;
		font-size: 0.9rem;
		letter-spacing: 0.12em;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.1rem, 6vw, 3.2rem);
		font-weight: 700;
		line-height: 1.45;
		color: #0b2748;
		unicode-bidi: isolate;
	}

	.ornament {
		display: block;
		width: 5rem;
		height: 0.75rem;
		margin: 1rem 0 1.1rem;
		background:
			linear-gradient(90deg, transparent, #1d9a8c 18%, #c9a227 50%, #1d9a8c 82%, transparent);
		clip-path: polygon(0 50%, 18% 0, 50% 50%, 82% 0, 100% 50%, 82% 100%, 50% 50%, 18% 100%);
	}

	.lead {
		margin: 0;
		font-size: 1.12rem;
		line-height: 2;
		color: #3d5470;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.5rem;
	}

	.actions a {
		text-decoration: none;
		padding: 0.62rem 1.15rem;
		border-radius: 999px;
		font-weight: 600;
	}

	.primary {
		background: #071428;
		color: #f4e4a6;
	}

	.secondary {
		background: transparent;
		color: #0b2748;
		border: 1px solid rgba(11, 39, 72, 0.28);
	}
</style>
