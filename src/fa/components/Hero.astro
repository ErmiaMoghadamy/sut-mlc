---
import constants from '../constants.json';
---

<section class="hero">
	<div class="hero-inner">
		<div class="hero-copy">
			<p class="kicker">{constants.hero.kicker}</p>
			<h1>{constants.hero.title}</h1>
			<p class="lead">{constants.hero.subtitle}</p>
			<p class="summary">{constants.hero.summary}</p>
			<div class="actions">
				<a class="primary" href={constants.hero.primaryCta.href}>{constants.hero.primaryCta.label}</a>
				<a class="secondary" href={constants.hero.secondaryCta.href}>{constants.hero.secondaryCta.label}</a>
			</div>
		</div>

		<aside class="info-panel" aria-label={constants.hero.panelTitle}>
			<p class="panel-label">{constants.hero.panelTitle}</p>
			<div class="panel-body">
				{constants.hero.panelItems.map((item) => (
					<div class="panel-item">
						<span class="panel-value">{item.value}</span>
						<span class="panel-meta">{item.meta}</span>
					</div>
				))}
			</div>
		</aside>
	</div>
</section>

<style>
	.hero {
		padding: 2.2rem 0 2rem;
	}

	.hero-inner {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(230px, 0.82fr);
		gap: 1.4rem;
		align-items: stretch;
		padding: clamp(1.25rem, 2vw, 2rem);
		border: 1px solid rgba(15, 33, 56, 0.08);
		border-radius: 1.6rem;
		background: linear-gradient(135deg, rgba(255,255,255,0.68), rgba(233, 242, 244, 0.86));
		box-shadow: var(--shadow-soft);
	}

	.hero-copy {
		max-width: 42rem;
		padding: 0.5rem 0.2rem;
	}

	.kicker {
		margin: 0 0 0.75rem;
		color: var(--teal-700);
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		font-weight: 800;
	}

	h1 {
		margin: 0;
		font-size: clamp(3.3rem, 6vw, 5.2rem);
		font-weight: 700;
		line-height: 0.9;
		letter-spacing: -0.04em;
		color: #081d2f;
	}

	.lead {
		margin: 1rem 0 0;
		max-width: 35rem;
		font-size: clamp(1.04rem, 1.5vw, 1.24rem);
		line-height: 1.7;
		color: #112a45;
	}

	.summary {
		margin: 1rem 0 0;
		max-width: 35rem;
		font-size: 1.02rem;
		line-height: 1.82;
		color: var(--stone-700);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.7rem;
	}

	.actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.9rem;
		padding: 0.75rem 1.25rem;
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	.actions a:hover {
		transform: translateY(-1px);
	}

	.primary {
		background: linear-gradient(135deg, #091d2e 0%, #163457 100%);
		color: #f8e6b7;
		box-shadow: 0 14px 22px rgba(8, 27, 47, 0.15);
	}

	.secondary {
		background: rgba(255, 255, 255, 0.5);
		color: #0b2748;
		border: 1px solid rgba(11, 39, 72, 0.13);
	}

	.info-panel {
		padding: 1.15rem 1rem 0.95rem;
		border: 1px solid rgba(28, 141, 135, 0.2);
		border-radius: 1.2rem;
		background: linear-gradient(180deg, rgba(255,255,255,0.82), rgba(223, 234, 234, 0.9));
		box-shadow: 0 18px 34px rgba(15, 30, 48, 0.06);
	}

	.panel-label {
		margin: 0 0 0.9rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #1c8d87;
	}

	.panel-body {
		display: grid;
		gap: 0.8rem;
	}

	.panel-item {
		display: flex;
		flex-direction: column;
		gap: 0.12rem;
		padding: 0.95rem 1rem;
		border-radius: 1rem;
		background: rgba(255,255,255,0.64);
		border: 1px solid rgba(11, 39, 72, 0.08);
	}

	.panel-value {
		font-size: 1.2rem;
		font-weight: 700;
		color: #0d2138;
	}

	.panel-meta {
		font-size: 0.88rem;
		color: var(--stone-700);
	}

	@media (max-width: 760px) {
		.hero-inner {
			grid-template-columns: 1fr;
		}

		.hero {
			padding-top: 1.5rem;
		}
	}
</style>
