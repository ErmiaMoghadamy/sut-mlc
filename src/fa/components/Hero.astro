---
import constants from '../constants.json';
---

<section class="hero">
	<div class="hero-inner">
		<div class="hero-copy">
			<p class="kicker">{constants.hero.kicker}</p>
			<h1>{constants.hero.title}</h1>
			<p class="lead">{constants.hero.subtitle}</p>
			<p class="summary">{constants.hero.summary}</p>
			<div class="actions">
				<a class="primary" href={constants.hero.primaryCta.href}>{constants.hero.primaryCta.label}</a>
				<a class="secondary" href={constants.hero.secondaryCta.href}>{constants.hero.secondaryCta.label}</a>
			</div>
		</div>

		<aside class="info-panel" aria-label={constants.hero.panelTitle}>
			<p class="panel-label">{constants.hero.panelTitle}</p>
			<div class="panel-body">
				{constants.hero.panelItems.map((item) => (
					<div class="panel-item">
						<span class="panel-value">{item.value}</span>
						<span class="panel-meta">{item.meta}</span>
					</div>
				))}
			</div>
		</aside>
	</div>
</section>

<style>
	.hero {
		padding: var(--space-8) 0 var(--space-8);
	}

	.hero-inner {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(230px, 0.82fr);
		gap: var(--space-6);
		align-items: stretch;
		padding: clamp(var(--space-5), 2vw, var(--space-8));
		border: 1px solid rgba(15, 23, 42, 0.07);
		border-radius: 1.6rem;
		background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(240, 244, 246, 0.96));
		box-shadow: var(--shadow-soft);
	}

	.hero-copy {
		max-width: 42rem;
		padding: var(--space-2) var(--space-1);
	}

	.kicker {
		margin: 0 0 0.8rem;
		color: var(--accent);
		font-size: 0.72rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		font-weight: 800;
	}

	h1 {
		margin: 0;
		font-size: clamp(3.1rem, 6vw, 5.5rem);
		font-weight: 700;
		line-height: 0.9;
		letter-spacing: -0.05em;
		color: var(--primary-strong);
	}

	.lead {
		margin: 1rem 0 0;
		max-width: 35rem;
		font-size: clamp(1.08rem, 1.7vw, 1.28rem);
		line-height: 1.7;
		color: var(--primary);
	}

	.summary {
		margin: 1rem 0 0;
		max-width: 35rem;
		font-size: 1.02rem;
		line-height: 1.8;
		color: var(--muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.7rem;
	}

	.actions a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.95rem;
		padding: 0.78rem 1.25rem;
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	.actions a:hover {
		transform: translateY(-1px);
	}

	.primary {
		background: linear-gradient(135deg, #0a1d2f 0%, #10324d 100%);
		color: #f7f3e9;
		box-shadow: 0 14px 26px rgba(10, 29, 47, 0.18);
	}

	.secondary {
		background: rgba(255, 255, 255, 0.78);
		color: var(--primary);
		border: 1px solid rgba(11, 34, 56, 0.08);
	}

	.info-panel {
		padding: 1.15rem 1rem 0.95rem;
		border: 1px solid rgba(27, 125, 118, 0.16);
		border-radius: 1.2rem;
		background: linear-gradient(180deg, rgba(255,255,255,0.85), rgba(234, 242, 245, 0.9));
		box-shadow: var(--shadow-card);
	}

	.panel-label {
		margin: 0 0 0.9rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.panel-body {
		display: grid;
		gap: 0.8rem;
	}

	.panel-item {
		display: flex;
		flex-direction: column;
		gap: 0.12rem;
		padding: 0.95rem 1rem;
		border-radius: 1rem;
		background: rgba(255,255,255,0.7);
		border: 1px solid rgba(11, 34, 56, 0.06);
	}

	.panel-value {
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--primary);
	}

	.panel-meta {
		font-size: 0.88rem;
		color: var(--muted);
	}

	@media (max-width: 760px) {
		.hero-inner {
			grid-template-columns: 1fr;
		}

		.hero {
			padding-top: 1.5rem;
		}
	}
</style>
