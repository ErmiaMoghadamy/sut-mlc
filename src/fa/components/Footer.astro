---
import constants from '../constants.json';

const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<div class="brand-block">
			<p class="footer-title">{constants.siteName}</p>
			<p>{constants.footer.text}</p>
			<p class="copy">© {year} {constants.siteName}. {constants.footer.copyright}</p>
		</div>
		<nav>
			{constants.nav.links.map((link) => (
				<a href={link.href}>{link.label}</a>
			))}
		</nav>
	</div>
</footer>

<style>
	footer {
		width: 100%;
		background: linear-gradient(180deg, rgba(10, 22, 35, 0.98), #071428);
		color: rgba(245, 241, 234, 0.82);
		margin-top: 1rem;
		border-top: 1px solid rgba(212, 170, 82, 0.18);
	}

	.inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 2rem var(--page-pad);
	}

	.brand-block {
		display: grid;
		gap: 0.35rem;
	}

	.footer-title {
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #f7d07a;
	}

	p {
		margin: 0;
		line-height: 1.7;
	}

	.copy {
		color: rgba(245, 241, 234, 0.7);
		font-size: 0.8rem;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	nav a {
		color: #edf1f4;
		text-decoration: none;
		padding: 0.5rem 0.8rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.02);
	}

	nav a:hover {
		border-color: rgba(212, 170, 82, 0.3);
	}
</style>
