---
import constants from '../constants.json';

const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<div>
			<p>{constants.footer.text}</p>
			<p class="copy">© {year} {constants.siteName}. {constants.footer.copyright}</p>
		</div>
		<nav>
			{constants.nav.links.map((link) => (
				<a href={link.href}>{link.label}</a>
			))}
		</nav>
	</div>
</footer>

<style>
	footer {
		width: 100%;
		background: linear-gradient(180deg, rgba(8, 27, 47, 0.98), #071428);
		color: rgba(245, 234, 208, 0.82);
		margin-top: 1rem;
	}

	.inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 2rem var(--page-pad);
	}

	p {
		margin: 0;
	}

	.copy {
		margin-top: 0.42rem;
		color: rgba(245, 234, 208, 0.7);
		font-size: 0.8rem;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
	}

	nav a {
		color: #f5ead0;
		text-decoration: none;
		opacity: 0.9;
	}

	nav a:hover {
		text-decoration: underline;
	}
</style>
