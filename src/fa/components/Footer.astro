---
import constants from '../constants.json';

const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<div class="brand-block">
			<p class="footer-title">{constants.siteName}</p>
			<p>{constants.footer.text}</p>
			<p class="copy">© {year} {constants.siteName}. {constants.footer.copyright}</p>
		</div>
		<nav>
			{constants.nav.links.map((link) => (
				<a href={link.href}>{link.label}</a>
			))}
		</nav>
	</div>
</footer>

<style>
	footer {
		width: 100%;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(241, 245, 246, 0.96));
		color: var(--ink-soft);
		margin-top: 1rem;
		border-top: 1px solid rgba(15, 23, 42, 0.08);
	}

	.inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
		max-width: var(--page-max);
		margin: 0 auto;
		padding: 2rem var(--page-pad);
	}

	.brand-block {
		display: grid;
		gap: 0.38rem;
	}

	.footer-title {
		font-size: 1.08rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--primary);
	}

	p {
		margin: 0;
		line-height: 1.7;
	}

	.copy {
		color: var(--muted);
		font-size: 0.8rem;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	nav a {
		color: var(--primary);
		text-decoration: none;
		padding: 0.52rem 0.8rem;
		border-radius: 999px;
		border: 1px solid rgba(15, 23, 42, 0.08);
		background: rgba(255, 255, 255, 0.55);
	}

	nav a:hover {
		border-color: rgba(27, 125, 118, 0.2);
		background: rgba(27, 125, 118, 0.04);
	}
</style>
