---
import { getCollection } from 'astro:content';
import constants from '../constants.json';

const posts = (await getCollection('blogFa'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<section class="latest-posts">
	<div class="heading">
		<h2>{constants.latestPosts.title}</h2>
		<a class="all" href="/fa/posts">{constants.latestPosts.all}</a>
	</div>
	{posts.length === 0 ? (
		<p class="empty">{constants.latestPosts.empty}</p>
	) : (
		<ul>
			{posts.map((post) => (
				<li>
					<a href={`/fa/posts/${post.id}`}>
						<span class="meta">
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('fa-IR')}
							</time>
							<em>{constants.kinds[post.data.kind]}</em>
						</span>
						<strong>{post.data.title}</strong>
						<span class="excerpt">{post.data.description}</span>
					</a>
				</li>
			))}
		</ul>
	)}
</section>

<style>
	.latest-posts {
		margin-top: 2.4rem;
	}

	.heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.2rem;
	}

	h2 {
		margin: 0;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(2rem, 3vw, 2.5rem);
		color: #0d2138;
	}

	.all {
		color: #1c8d87;
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 700;
		max-width: 10rem;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	li {
		display: flex;
	}

	a {
		display: grid;
		gap: 0.35rem;
		height: 100%;
		width: 100%;
		padding: 1.1rem 1.15rem;
		text-decoration: none;
		color: inherit;
		background: rgba(255, 255, 255, 0.58);
		border: 1px solid rgba(11, 39, 72, 0.08);
		border-top: 3px solid #d0a74a;
		border-radius: 1rem;
		box-shadow: 0 12px 24px rgba(7, 20, 40, 0.04);
		transition: transform 0.18s ease, box-shadow 0.18s ease;
	}

	a:hover {
		transform: translateY(-2px);
		box-shadow: 0 18px 28px rgba(7, 20, 40, 0.08);
	}

	.meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		color: #1c8d87;
		font-size: 0.76rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	time {
		color: #52657a;
	}

	em {
		font-style: normal;
		color: #d0a74a;
	}

	strong {
		font-size: 1.1rem;
		color: #0d2138;
		line-height: 1.4;
	}

	.excerpt {
		color: #53657b;
		font-size: 0.94rem;
		line-height: 1.6;
	}

	.empty {
		margin: 0;
		padding: 1.1rem 0;
		color: #51657b;
	}

	@media (max-width: 840px) {
		ul {
			grid-template-columns: 1fr;
		}
	}
</style>
