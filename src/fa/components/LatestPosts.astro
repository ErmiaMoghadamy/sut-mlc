---
import { getCollection } from 'astro:content';
import constants from '../constants.json';

const posts = (await getCollection('blogFa'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<section class="latest-posts">
	<div class="heading">
		<h2>{constants.latestPosts.title}</h2>
		<a class="all" href="/fa/posts">{constants.latestPosts.all}</a>
	</div>
	{posts.length === 0 ? (
		<p class="empty">{constants.latestPosts.empty}</p>
	) : (
		<ul>
			{posts.map((post, index) => (
				<li class:list={['post-item', `tone-${(index % 3) + 1}`]}>
					<a href={`/fa/posts/${post.id}`}>
						<span class="meta">
							<time datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('fa-IR')}
							</time>
							<em>{constants.kinds[post.data.kind]}</em>
						</span>
						<strong>{post.data.title}</strong>
						<span class="excerpt">{post.data.description}</span>
					</a>
				</li>
			))}
		</ul>
	)}
</section>

<style>
	.latest-posts {
		margin-top: 2.4rem;
	}

	.heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.2rem;
	}

	h2 {
		margin: 0;
		font-family: "Cormorant Garamond", Georgia, serif;
		font-size: clamp(2.1rem, 3vw, 2.8rem);
		color: var(--primary-strong);
	}

	.all {
		color: var(--teal);
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 700;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	li {
		display: flex;
	}

	a {
		display: grid;
		gap: 0.45rem;
		height: 100%;
		width: 100%;
		padding: 1.2rem 1.15rem;
		text-decoration: none;
		color: inherit;
		border: 1px solid rgba(138, 155, 179, 0.1);
		border-radius: 1.2rem;
		box-shadow: var(--shadow-card);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}

	.post-item {
		--card-bg: linear-gradient(180deg, rgba(37, 46, 63, 0.96), rgba(45, 56, 74, 0.96));
		--card-accent: var(--teal);
		--card-accent-soft: rgba(74, 155, 149, 0.16);
	}

	.post-item.tone-1 {
		--card-bg: linear-gradient(180deg, rgba(45, 56, 74, 0.96), rgba(37, 46, 63, 0.96));
		--card-accent: var(--primary);
		--card-accent-soft: rgba(184, 134, 11, 0.15);
	}

	.post-item.tone-2 {
		--card-bg: linear-gradient(180deg, rgba(37, 46, 63, 0.96), rgba(45, 56, 74, 0.96));
		--card-accent: var(--teal);
		--card-accent-soft: rgba(74, 155, 149, 0.18);
	}

	.post-item.tone-3 {
		--card-bg: linear-gradient(180deg, rgba(45, 56, 74, 0.96), rgba(37, 46, 63, 0.96));
		--card-accent: var(--accent-strong);
		--card-accent-soft: rgba(184, 134, 11, 0.15);
	}

	.post-item a {
		background: var(--card-bg);
		border-inline-start: 4px solid var(--card-accent);
	}

	.post-item a:hover {
		transform: translateY(-2px);
		box-shadow: 0 22px 36px rgba(26, 32, 44, 0.15);
		border-color: rgba(138, 155, 179, 0.15);
	}

	.meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	time {
		color: var(--muted);
	}

	em {
		font-style: normal;
		color: var(--card-accent);
		background: var(--card-accent-soft);
		padding: 0.28rem 0.5rem;
		border-radius: 999px;
	}

	strong {
		font-size: 1.16rem;
		color: var(--primary-strong);
		line-height: 1.4;
	}

	.excerpt {
		color: var(--ink-soft);
		font-size: 0.95rem;
		line-height: 1.7;
		margin-top: 0.15rem;
	}

	.empty {
		margin: 0;
		padding: 1.1rem 0;
		color: var(--muted);
	}

	@media (max-width: 840px) {
		ul {
			grid-template-columns: 1fr;
		}
	}
</style>
