---
import constants from "../constants.json";
import AmuritBar from "../components/AmuritBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
}

const { title, description = constants.hero.subtitle } = Astro.props;
const pageTitle = title
    ? `${title} · ${constants.siteName}`
    : constants.siteName;
---

<!doctype html>
<html lang={constants.lang} dir={constants.dir}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;700&display=swap"
            rel="stylesheet"
        />
        <title>{pageTitle}</title>
    </head>
    <body>
        <!-- <AmuritBar /> -->
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style is:global>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    :root {
        --page-max: 76rem;
        --page-pad: 1.5rem;
    }

    html {
        font-family: Vazirmatn, Tahoma, sans-serif;
        background: linear-gradient(180deg, #f6f0e7 0%, #efe4d1 100%);
        color: #1d1a17;
        scroll-behavior: smooth;
    }

    body {
        position: relative;
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background:
            radial-gradient(circle at top, rgba(29, 154, 140, 0.14), transparent 38%),
            radial-gradient(circle at bottom left, rgba(201, 162, 39, 0.12), transparent 34%),
            linear-gradient(180deg, #f7f2e8 0%, #f0e5d1 100%);
        color: #1d1a17;
    }

    body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image: url('/patterns/girih.svg');
        background-size: 180px 180px;
        opacity: 0.08;
        mix-blend-mode: multiply;
    }

    main {
        position: relative;
        flex: 1;
        width: 100%;
        max-width: var(--page-max);
        margin: 0 auto;
        padding: 1.8rem var(--page-pad) 3.5rem;
    }

    article {
        padding-top: 1rem;
        max-width: 46rem;
    }

    article :where(p, ul, ol) {
        line-height: 2;
        color: #2d2a27;
    }

    article a {
        color: #1c4f8a;
    }

    article h1,
    article h2,
    article h3 {
        color: #0f1d2d;
        letter-spacing: -0.02em;
    }

    article h1 {
        font-weight: 700;
    }
</style>
