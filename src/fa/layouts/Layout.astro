---
import constants from "../constants.json";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
}

const { title, description = constants.hero.subtitle } = Astro.props;
const pageTitle = title
    ? `${title} · ${constants.siteName}`
    : constants.siteName;
---

<!doctype html>
<html lang={constants.lang} dir={constants.dir}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="/fonts/fa.css" rel="stylesheet" />
        <title>{pageTitle}</title>
    </head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style is:global>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    :root {
        --page-max: 76rem;
        --page-pad: 1.5rem;
        --space-1: 0.25rem;
        --space-2: 0.5rem;
        --space-3: 0.75rem;
        --space-4: 1rem;
        --space-5: 1.25rem;
        --space-6: 1.5rem;
        --space-8: 2rem;
        --space-10: 2.5rem;
        --space-12: 3rem;
        --bg: #f4f6f7;
        --bg-strong: #edf3f4;
        --surface: rgba(255, 255, 255, 0.78);
        --surface-strong: #ffffff;
        --ink: #0f172a;
        --ink-soft: #334155;
        --muted: #5f7284;
        --line: rgba(15, 23, 42, 0.08);
        --primary: #0b2238;
        --primary-strong: #061827;
        --accent: #1b7d76;
        --accent-soft: rgba(27, 125, 118, 0.12);
        --gold: #b58b2b;
        --shadow-soft: 0 24px 42px rgba(15, 23, 42, 0.08);
        --shadow-card: 0 18px 28px rgba(15, 23, 42, 0.05);
    }

    html {
        font-family: "Vazirmatn", Tahoma, sans-serif;
        background: var(--bg);
        color: var(--ink);
        scroll-behavior: smooth;
    }

    body {
        position: relative;
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background:
            radial-gradient(circle at top left, rgba(27, 125, 118, 0.09), transparent 24%),
            radial-gradient(circle at top right, rgba(181, 139, 43, 0.09), transparent 18%),
            linear-gradient(180deg, #f7f4ee 0%, #eef3f5 100%);
        color: var(--ink);
    }

    body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(circle at center, rgba(11, 34, 56, 0.03), transparent 65%);
        opacity: 0.8;
    }

    main {
        position: relative;
        flex: 1;
        width: min(100%, calc(var(--page-max) + 2rem));
        margin: 0 auto;
        padding: var(--space-6) var(--page-pad) var(--space-12);
    }

    article {
        padding-top: var(--space-4);
        max-width: 46rem;
    }

    article :where(p, ul, ol) {
        line-height: 1.8;
        color: var(--ink-soft);
    }

    article a {
        color: #0f5a8b;
    }

    article h1,
    article h2,
    article h3 {
        color: var(--primary-strong);
        letter-spacing: -0.02em;
    }

    article h1 {
        font-weight: 700;
    }

    a {
        transition: opacity 0.2s ease, transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    ::selection {
        background: rgba(27, 125, 118, 0.16);
    }
</style>
