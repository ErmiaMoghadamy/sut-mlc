---
import constants from "../constants.json";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
}

const { title, description = constants.hero.subtitle } = Astro.props;
const pageTitle = title
    ? `${title} · ${constants.siteName}`
    : constants.siteName;
---

<!doctype html>
<html lang={constants.lang} dir={constants.dir}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="/fonts/fa.css" rel="stylesheet" />
        <title>{pageTitle}</title>
    </head>
    <body>
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style is:global>
    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    :root {
        --page-max: 76rem;
        --page-pad: 1.5rem;
        --space-1: 0.25rem;
        --space-2: 0.5rem;
        --space-3: 0.75rem;
        --space-4: 1rem;
        --space-5: 1.25rem;
        --space-6: 1.5rem;
        --space-8: 2rem;
        --space-10: 2.5rem;
        --space-12: 3rem;
        --bg: #1e2430;
        --bg-strong: #283446;
        --surface: rgba(50, 62, 82, 0.96);
        --surface-strong: #3d4a5e;
        --ink: #e8eef5;
        --ink-soft: #b8c5d6;
        --muted: #8a9bb3;
        --line: rgba(138, 155, 179, 0.25);
        --primary: #e8eef5;
        --primary-strong: #f5f7fa;
        --accent: #b8860b;
        --accent-strong: #d4a545;
        --accent-soft: rgba(184, 134, 11, 0.1);
        --teal: #4a9b95;
        --teal-soft: rgba(74, 155, 149, 0.12);
        --slate: #3d4a5e;
        --shadow-soft: 0 26px 58px rgba(30, 36, 48, 0.3);
        --shadow-card: 0 18px 34px rgba(30, 36, 48, 0.25);
    }

    html {
        font-family: "Vazirmatn", Tahoma, sans-serif;
        background: var(--bg);
        color: var(--ink);
        scroll-behavior: smooth;
    }

    body {
        position: relative;
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background:
            radial-gradient(circle at top left, rgba(74, 155, 149, 0.1), transparent 25%),
            radial-gradient(circle at top right, rgba(184, 134, 11, 0.1), transparent 22%),
            radial-gradient(circle at bottom left, rgba(74, 155, 149, 0.05), transparent 30%),
            linear-gradient(180deg, #1e2430 0%, #283446 100%);
        color: var(--ink);
    }

    body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background: 
            linear-gradient(180deg, rgba(30, 36, 48, 0.12), rgba(30, 36, 48, 0)),
            radial-gradient(circle at 50% 50%, rgba(74, 155, 149, 0.03), transparent 50%);
        opacity: 1;
    }

    main {
        position: relative;
        flex: 1;
        width: min(100%, calc(var(--page-max) + 2rem));
        margin: 0 auto;
        padding: clamp(1.25rem, 2vw, 2rem) var(--page-pad) 4rem;
    }

    article {
        padding-top: var(--space-4);
        max-width: 46rem;
    }

    article :where(p, ul, ol) {
        line-height: 1.8;
        color: var(--ink-soft);
        font-weight: 400;
    }

    article a {
        color: #6bc7c1;
    }

    article h1,
    article h2,
    article h3 {
        color: var(--primary-strong);
        letter-spacing: -0.02em;
        font-weight: 600;
    }

    article h1 {
        font-weight: 600;
    }

    a {
        transition: opacity 0.2s ease, transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    ::selection {
        background: rgba(74, 155, 149, 0.2);
    }
</style>
